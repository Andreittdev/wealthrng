local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local marketUpdateEvent = remotes:WaitForChild("MarketUpdate")
local getMarketDataFunction = remotes:WaitForChild("GetMarketData")

local marketGui = script.Parent
local marketFrame = marketGui:WaitForChild("MarketFrame")

local mainHud = playerGui:WaitForChild("MainHUD")
