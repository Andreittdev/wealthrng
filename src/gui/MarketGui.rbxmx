local progressCorner = Instance.new("UICorner")
progressCorner.CornerRadius = UDim.new(1, 0)
progressCorner.Parent = progressBar

local function getPercent(data)
	if type(data) == "table" then
		return data.Percent or 0
	end

	if type(data) == "number" then
		return math.floor((data - 1) * 100)
	end

	return 0
end

local function getArrow(value)
	if value > 0 then
		return "▲", Color3.fromRGB(90, 255, 130)
	elseif value < 0 then
		return "▼", Color3.fromRGB(255, 100, 100)
	end

	return "─", Color3.fromRGB(220, 220, 220)
end

local function updateTheme()
	local eventType = currentSpecialEvent.Type or "None"

	if eventType == "GoldenHour" then
		stroke.Color = Color3.fromRGB(255, 210, 80)
		progressBar.BackgroundColor3 = Color3.fromRGB(255, 210, 80)
		statusValue.Text = "▲ Golden Hour"
		statusValue.TextColor3 = Color3.fromRGB(255, 210, 80)
	elseif eventType == "MarketCrash" then
		stroke.Color = Color3.fromRGB(255, 80, 80)
		progressBar.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
		statusValue.Text = "▼ Market Crash"
		statusValue.TextColor3 = Color3.fromRGB(255, 80, 80)
	else
		stroke.Color = Color3.fromRGB(120, 120, 130)
		progressBar.BackgroundColor3 = Color3.fromRGB(90, 180, 255)
		statusValue.Text = "─ Normal Market"
		statusValue.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end

local function updateMarketUI()
	local bestCategory = nil
	local worstCategory = nil
	local bestPercent = -999
	local worstPercent = 999

	for _, category in ipairs(categories) do
		local percent = getPercent(currentMarket[category] or {Percent = 0})
		local arrow, color = getArrow(percent)
		local sign = percent > 0 and "+" or ""

		rowLabels[category].Text = string.format("%-13s %s %s%d%%", category, arrow, sign, percent)
		rowLabels[category].TextColor3 = color

		if percent > bestPercent then
			bestPercent = percent
			bestCategory = category
		end

		if percent < worstPercent then
			worstPercent = percent
			worstCategory = category
		end
	end

	if bestCategory and bestPercent > 0 then
		hotLabel.Text = "BEST: " .. bestCategory .. " +" .. bestPercent .. "%"
	else
		hotLabel.Text = "BEST: None"
	end

	if worstCategory and worstPercent < 0 then
		worstLabel.Text = "WORST: " .. worstCategory .. " " .. worstPercent .. "%"
	else
		worstLabel.Text = "WORST: None"
	end

	local minutes = math.floor(timeLeft / 60)
	local seconds = timeLeft % 60
	local timeText = string.format("%02d:%02d", minutes, seconds)

	-- Cand NU e activ niciun eveniment: "Next Market Update" (updatarea
	-- GENERALA de preturi, la fiecare 10 minute). Cand UNUL e activ chiar
	-- acum: doar "Ends in:" (fara "GOLDEN HOUR ACTIVE!" -- text pe doua
	-- randuri intr-o caseta de un rand facea totul ilizibil/inghesuit,
	-- cerut explicit sa fie scos) -- acelasi numar ca pe panoul din tunel,
	-- sincronizat.
	if currentSpecialEvent.Type == "GoldenHour" or currentSpecialEvent.Type == "MarketCrash" then
		timerLabel.Text = "Ends in: " .. timeText
	else
		timerLabel.Text = "Next Market Update: " .. timeText
	end

	progressBar.Size = UDim2.new(
		math.clamp(timeLeft / marketUpdateTime, 0, 1),
		0,
		progressBar.Size.Y.Scale,
		progressBar.Size.Y.Offset
	)

	updateTheme()
end

task.spawn(function()
	local success, data = pcall(function()
		return getMarketDataFunction:InvokeServer()
	end)

	if success and data then
		if data.Categories then
			currentMarket = data.Categories
			currentSpecialEvent = data.SpecialEvent or {Type = "None"}
		end

		-- Daca un eveniment special e activ ACUM, folosim countdown-ul lui
		-- (acelasi ca pe panoul din tunel) -- altfel, timpul real ramas din
		-- slot-ul curent (nu un 10:00 fix), sincronizat cu orarul serverului.
		if currentSpecialEvent.Type ~= "None" and data.EventCountdown then
			timeLeft = data.EventCountdown.SecondsLeft
		else
			timeLeft = data.SecondsUntilNextUpdate or marketUpdateTime
		end

		updateMarketUI()
	end
end)

marketButton.Activated:Connect(function()
	marketFrame.Visible = not marketFrame.Visible

	if marketFrame.Visible then
		updateMarketUI()
	end
end)

marketUpdateEvent.OnClientEvent:Connect(function(newMarket)
	if not newMarket then
		return
	end

	if newMarket.Categories then
		currentMarket = newMarket.Categories
		currentSpecialEvent = newMarket.SpecialEvent or {Type = "None"}
	else
		currentMarket = newMarket
		currentSpecialEvent = {Type = "None"}
	end

	if currentSpecialEvent.Type ~= "None" and newMarket.EventCountdown then
		timeLeft = newMarket.EventCountdown.SecondsLeft
	else
		timeLeft = newMarket.SecondsUntilNextUpdate or marketUpdateTime
	end

	updateMarketUI()
end)

task.spawn(function()
	while true do
		if marketFrame.Visible then
			updateMarketUI()
		end

		task.wait(1)

		-- NU se mai reseteaza singur la un numar fix cand ajunge la 0 --
		-- ramane pe 0 pana vine urmatorul broadcast real de la server (care
		-- soseste exact cand se schimba ceva: incepe/se termina un eveniment,
		-- sau trece un slot nou), ca sa nu se desincronizeze niciodata.
		timeLeft = math.max(0, timeLeft - 1)
	end
end)]]></ProtectedString>
