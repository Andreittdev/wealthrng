local isMobile = UserInputService.TouchEnabled

marketFrame.Visible = false
marketFrame.AnchorPoint = Vector2.new(0.5, 0.5)
marketFrame.BackgroundColor3 = Color3.fromRGB(28, 29, 36)
marketFrame.BorderSizePixel = 0

if isMobile then
	marketFrame.Size = UDim2.new(0, 270, 0, 300)
	marketFrame.Position = UDim2.new(0.52, 0, 0.47, 0)
else
	marketFrame.Size = UDim2.new(0, 420, 0, 430)
	marketFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
end

for _, child in ipairs(marketFrame:GetChildren()) do
	child:Destroy()
end

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 18)
corner.Parent = marketFrame

local stroke = Instance.new("UIStroke")
stroke.Thickness = 3
stroke.Color = Color3.fromRGB(120, 120, 130)
stroke.Parent = marketFrame

local function createText(parent, name, text, pos, size, textSize, color, align)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Parent = parent
	label.BackgroundTransparency = 1
	label.Position = pos
	label.Size = size
	label.Font = Enum.Font.FredokaOne
	label.Text = text or ""
	label.TextSize = textSize
	label.TextScaled = false
	label.TextXAlignment = align or Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
	return label
end

local function createBox(parent, name, pos, size)
	local box = Instance.new("Frame")
	box.Name = name
	box.Parent = parent
	box.Position = pos
	box.Size = size
	box.BackgroundColor3 = Color3.fromRGB(38, 39, 48)
	box.BorderSizePixel = 0

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 12)
	c.Parent = box

	local s = Instance.new("UIStroke")
	s.Thickness = 1
	s.Color = Color3.fromRGB(75, 75, 90)
	s.Parent = box

	return box
end

local titleSize = isMobile and 22 or 32
createText(
	marketFrame,
	"Title",
	"📈 MARKET",
	UDim2.new(0, 0, 0, isMobile and 8 or 14),
