	)

	hotLabel = createText(
		infoBox,
		"HotLabel",
		"BEST: None",
		UDim2.new(0, 12, 0, 1),
		UDim2.new(1, -24, 0, 18),
		11,
		Color3.fromRGB(90, 255, 130),
		Enum.TextXAlignment.Left
	)

	worstLabel = createText(
		infoBox,
		"WorstLabel",
		"WORST: None",
		UDim2.new(0, 12, 0, 21),
		UDim2.new(1, -24, 0, 18),
		11,
		Color3.fromRGB(255, 100, 100),
		Enum.TextXAlignment.Left
	)

	local timerBox = createBox(
		marketFrame,
		"TimerBox",
		UDim2.new(0, 14, 0, 262),
		UDim2.new(1, -28, 0, 26)
	)

	timerLabel = createText(
		timerBox,
		"TimerLabel",
		"Next Update: 10:00",
		UDim2.new(0, 12, 0, 0),
		UDim2.new(1, -24, 0, 16),
		10,
		Color3.fromRGB(230, 230, 235),
		Enum.TextXAlignment.Left
	)

	progressBar = Instance.new("Frame")
	progressBar.Name = "ProgressBar"
	progressBar.Parent = timerBox
	progressBar.Position = UDim2.new(0, 12, 1, -6)
	progressBar.Size = UDim2.new(1, -24, 0, 4)
	progressBar.BackgroundColor3 = Color3.fromRGB(90, 180, 255)
	progressBar.BorderSizePixel = 0
else
	local categoriesBox = createBox(
		marketFrame,
		"CategoriesBox",
		UDim2.new(0, 24, 0, 72),
		UDim2.new(1, -48, 0, 165)
	)

	for index, category in ipairs(categories) do
		local y = 10 + ((index - 1) * 30)

		local row = createText(
			categoriesBox,
			category .. "Row",
			category .. "     ─ 0%",
			UDim2.new(0, 16, 0, y),
			UDim2.new(1, -32, 0, 26),
