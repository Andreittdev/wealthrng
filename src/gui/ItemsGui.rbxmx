			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local requestItemsEvent = remotes:WaitForChild("PetInventoryRequest")
local updateItemsEvent = remotes:WaitForChild("PetInventoryUpdate")
local petOpenedEvent = remotes:WaitForChild("PetOpened")

local PetDatabase = require(ReplicatedStorage.Modules:WaitForChild("PetDatabase"))

local gui = script.Parent
local mainFrame = gui:WaitForChild("MainFrame")
local closeButton = mainFrame:WaitForChild("CloseButton")
local itemsList = mainFrame:WaitForChild("ItemsList")

local isMobile = UserInputService.TouchEnabled

local rarityColors = {
	Common = Color3.fromRGB(150, 150, 150),
	Rare = Color3.fromRGB(60, 150, 255),
	Epic = Color3.fromRGB(170, 90, 255),
	Legendary = Color3.fromRGB(255, 180, 40),
	Mythic = Color3.fromRGB(255, 70, 180)
}

local function addCorner(obj, radius)
	local corner = obj:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
	corner.CornerRadius = radius
	corner.Parent = obj
end

local function addStroke(obj, color, thickness)
	local stroke = obj:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.Parent = obj
end

local function setupLayout()
	gui.Enabled = true
	gui.DisplayOrder = 220

	mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	mainFrame.BackgroundColor3 = Color3.fromRGB(10, 15, 28)
	mainFrame.Visible = false

	if isMobile then
		mainFrame.Size = UDim2.new(0.82, 0, 0.75, 0)
	else
		mainFrame.Size = UDim2.new(0.58, 0, 0.65, 0)
	end

	addCorner(mainFrame, UDim.new(0.04, 0))
	addStroke(mainFrame, Color3.fromRGB(70, 140, 255), 3)

	local title = mainFrame:FindFirstChild("Title") or Instance.new("TextLabel")
	title.Name = "Title"
	title.Parent = mainFrame
	title.Text = "🐾 PETS"
	title.BackgroundTransparency = 1
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextScaled = true
	title.Font = Enum.Font.GothamBlack
	title.Position = UDim2.new(0.06, 0, 0.03, 0)
	title.Size = UDim2.new(0.65, 0, 0.10, 0)
	title.ZIndex = 20

	closeButton.Text = "X"
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(0.96, 0, 0.035, 0)
	closeButton.Size = UDim2.new(0.08, 0, 0.09, 0)
	closeButton.BackgroundTransparency = 1
	closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeButton.TextScaled = true
	closeButton.Font = Enum.Font.GothamBlack
	closeButton.ZIndex = 30

	-- Pe PC lasam loc in dreapta pentru cardul mare de detalii (mereu vizibil,
	-- nu suprapus peste grid) -- pe mobil ramane cum era, grid pe toata
	-- latimea, detaliile apar ca popup peste el.
	if isMobile then
		itemsList.Position = UDim2.new(0.05, 0, 0.16, 0)
		itemsList.Size = UDim2.new(0.90, 0, 0.78, 0)
	else
		itemsList.Position = UDim2.new(0.03, 0, 0.16, 0)
		itemsList.Size = UDim2.new(0.55, 0, 0.80, 0)
	end
	itemsList.BackgroundColor3 = Color3.fromRGB(15, 22, 38)
	itemsList.BorderSizePixel = 0
	itemsList.ScrollBarThickness = 6
	itemsList.ZIndex = 10
	addCorner(itemsList, UDim.new(0.03, 0))

	local grid = itemsList:FindFirstChildOfClass("UIGridLayout") or Instance.new("UIGridLayout")
	grid.Parent = itemsList
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.CellPadding = UDim2.new(0, 10, 0, 10)

	if isMobile then
		grid.CellSize = UDim2.new(0, 120, 0, 150)
	else
		grid.CellSize = UDim2.new(0, 150, 0, 175)
	end

	grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		itemsList.CanvasSize = UDim2.new(0, 0, 0, grid.AbsoluteContentSize.Y + 20)
	end)
end

local function clearItems()
	for _, child in ipairs(itemsList:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function createPetCard(petInfo)
	local petId
	local instanceName

	if type(petInfo) == "table" then
		petId = petInfo.PetId
		instanceName = petInfo.InstanceName
	else
		petId = petInfo
		instanceName = petInfo
	end

	local data = PetDatabase.Pets[petId]
	if not data then
		warn("Missing pet data:", petId)
		return
	end

	local color = rarityColors[data.Rarity] or Color3.fromRGB(255, 255, 255)

	local card = Instance.new("TextButton")
	card.Name = instanceName or petId
	card.Parent = itemsList
	card.BackgroundColor3 = Color3.fromRGB(22, 30, 48)
	card.Text = ""
	card.AutoButtonColor = true
	card.ZIndex = 15
	addCorner(card, UDim.new(0.08, 0))
	addStroke(card, color, 2)

	local icon = Instance.new("ImageLabel")
	icon.Parent = card
	icon.BackgroundTransparency = 1
	icon.Image = data.Image or ""
	icon.Position = UDim2.new(0.28, 0, 0.05, 0)
	icon.Size = UDim2.new(0.44, 0, 0.32, 0)
	icon.ZIndex = 16

	local name = Instance.new("TextLabel")
	name.Parent = card
	name.BackgroundTransparency = 1
	name.Text = data.DisplayName
	name.TextColor3 = Color3.fromRGB(255, 255, 255)
	name.TextScaled = true
	name.TextWrapped = true
	name.Font = Enum.Font.GothamBlack
	name.Position = UDim2.new(0.06, 0, 0.40, 0)
	name.Size = UDim2.new(0.88, 0, 0.20, 0)
	name.ZIndex = 16

	local rarity = Instance.new("TextLabel")
	rarity.Parent = card
	rarity.BackgroundTransparency = 1
	rarity.Text = data.Rarity
	rarity.TextColor3 = color
	rarity.TextScaled = true
	rarity.Font = Enum.Font.GothamBold
	rarity.Position = UDim2.new(0.10, 0, 0.62, 0)
	rarity.Size = UDim2.new(0.80, 0, 0.16, 0)
	rarity.ZIndex = 16

	local tap = Instance.new("TextLabel")
	tap.Parent = card
	tap.BackgroundTransparency = 1
	tap.Text = "Tap for details"
	tap.TextColor3 = Color3.fromRGB(190, 200, 220)
	tap.TextScaled = true
	tap.Font = Enum.Font.GothamBold
	tap.Position = UDim2.new(0.10, 0, 0.80, 0)
	tap.Size = UDim2.new(0.80, 0, 0.14, 0)
	tap.ZIndex = 16

	card.Activated:Connect(function()
		if _G.OpenItemDetails then
			_G.OpenItemDetails(petId, instanceName)
		end
	end)
end

local function refreshItems(pets)
	clearItems()

	print("PET INVENTORY RECEIVED:", pets and #pets or 0)

	if not pets or #pets == 0 then
		local empty = Instance.new("TextLabel")
		empty.Parent = itemsList
		empty.BackgroundTransparency = 1
		empty.Text = "No pets yet.\nOpen crates to collect pets."
		empty.TextColor3 = Color3.fromRGB(255, 255, 255)
		empty.TextScaled = true
		empty.Font = Enum.Font.GothamBlack
		empty.Size = UDim2.new(1, 0, 0, 80)
		return
	end

	for _, petInfo in ipairs(pets) do
		createPetCard(petInfo)
	end
end
local function refreshFromPlayerPets()
	local petsFolder = player:FindFirstChild("Pets")

	if petsFolder then
		petsFolder.ChildAdded:Connect(function()
			if mainFrame.Visible then
				refreshFromPlayerPets()
			end
		end)

		petsFolder.ChildRemoved:Connect(function()
			if mainFrame.Visible then
				refreshFromPlayerPets()
			end
		end)
	end
	if not petsFolder then
		refreshItems({})
		return
	end
	local pets = {}

	for _, petValue in ipairs(petsFolder:GetChildren()) do
		if petValue:IsA("StringValue") then
			table.insert(pets, {
				InstanceName = petValue.Name,
				PetId = petValue.Value
			})
		end
	end

	refreshItems(pets)
end

setupLayout()

closeButton.Activated:Connect(function()
	mainFrame.Visible = false
end)
updateItemsEvent.OnClientEvent:Connect(function(pets)
	refreshItems(pets)
end)

petOpenedEvent.OnClientEvent:Connect(function()
	task.wait(0.5)
	refreshFromPlayerPets()
end)

-- Acelasi flag comun folosit de Starter Pack/Rebirth/Daily Rewards/Token
-- Shop/Inventory/Store/Stand Upgrade -- cat timp Pets e deschis, celelalte
-- butoane de pe ecran se ascund.
mainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
	player:SetAttribute("ShopModalOpen", mainFrame.Visible)

	if mainFrame.Visible then
		refreshFromPlayerPets()
	end
end)

local petsFolder = player:WaitForChild("Pets")
petsFolder.ChildAdded:Connect(function()
	if mainFrame.Visible then
		refreshFromPlayerPets()
	end
end)

petsFolder.ChildRemoved:Connect(function()
	if mainFrame.Visible then
		refreshFromPlayerPets()
	end
end)]]></ProtectedString>
				<bool name="Disabled">false</bool>
