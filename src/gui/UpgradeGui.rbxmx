		<Item class="LocalScript" referent="RBX293EEC4F6F2C46869BE19559050D249B">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Economy = require(ReplicatedStorage.Modules:WaitForChild("EconomyConfig"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local upgradeStandEvent = remotes:WaitForChild("UpgradeStand")
local updateStandLevelEvent = remotes:WaitForChild("UpdateStandLevel")
local requestStandLevelEvent = remotes:WaitForChild("RequestStandLevel")

local standGui = script.Parent
local mainFrame = standGui:WaitForChild("MainFrame")

-- TouchEnabled singur nu e de incredere -- verificam si dimensiunea reala a
-- ecranului (acelasi fix aplicat si la EggShopGui/StoreGui/TradeGui/InventoryV2).
local function computeIsMobile()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	return UserInputService.TouchEnabled or viewport.X < 700 or viewport.Y < 500
end

-- Asteptam un ViewportSize real inainte sa decidem isMobile -- altfel, la
-- un ecran care raporteaza o rezolutie implicita/gresita la primul frame,
-- layout-ul putea "inghetta" gresit pe desktop/mobil pentru toata sesiunea
-- (acelasi bug gasit si reparat la EggShopGui/InventoryV2).
local function waitForRealViewport()
	local attempts = 0

	while attempts < 30 do
		local camera = workspace.CurrentCamera

		if camera and camera.ViewportSize.Magnitude > 1 then
			return
		end

		task.wait(0.1)
		attempts += 1
	end
end

waitForRealViewport()

local isMobile = computeIsMobile()

-- Butonul "STAND" din HUD a fost scos -- panoul se deschide/inchide singur
-- cand jucatorul calca pe podeaua standului lui (vezi bucla de mai jos,
-- "Zona galbena de la stand", si ClaimZone-ul creat in StandManager.server.luau).

local header = mainFrame:WaitForChild("Header")
local closeButton = header:WaitForChild("CloseButton")
local upgradeButton = mainFrame:WaitForChild("UpgradeButton")

local currentNumber = mainFrame:FindFirstChild("CurrentNumber", true)
local nextNumber = mainFrame:FindFirstChild("NextNumber", true)
local costLabel = mainFrame:FindFirstChild("CostLabel", true)
local costBox = costLabel and costLabel.Parent

local currentPerksLabel = mainFrame:FindFirstChild("CurrentPerksLabel", true)
local nextPerksLabel = mainFrame:FindFirstChild("NextPerksLabel", true)

local currentFrame = currentNumber and currentNumber.Parent
local nextFrame = nextNumber and nextNumber.Parent
local currentPerksFrame = currentPerksLabel and currentPerksLabel.Parent
local nextPerksFrame = nextPerksLabel and nextPerksLabel.Parent

local oldScale = mainFrame:FindFirstChild("MobileScale")
if oldScale then oldScale:Destroy() end

local MAX_LEVEL = 5

local currentPerks = {
	[1] = "Base Stand",
	[2] = "🍀 NPC Luck +5%",
	[3] = "🍀 NPC Luck +10%\n💰 Sell Price +10%",
	[4] = "🍀 NPC Luck +20%\n💰 Sell Price +15%\n⚡ NPC Speed +15%",
	[5] = "🍀 NPC Luck +30%\n💰 Sell Price +25%\n⚡ NPC Speed +25%"
}

local nextPerks = {
	[1] = "🍀 NPC Luck +5%",
	[2] = "🍀 NPC Luck +10%\n💰 Sell Price +10%",
	[3] = "🍀 NPC Luck +20%\n💰 Sell Price +15%\n⚡ NPC Speed +15%",
	[4] = "🍀 NPC Luck +30%\n💰 Sell Price +25%\n⚡ NPC Speed +25%",
	[5] = "MAX LEVEL"
}

local currentLevel = 1

local function fixLevelBox(frame, numberLabel)
	if not frame or not numberLabel then return end

	frame.ClipsDescendants = false

	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("TextLabel") and child ~= numberLabel then
			child.Position = UDim2.new(0, 0, 0.06, 0)
			child.Size = UDim2.new(1, 0, 0.34, 0)
			child.TextScaled = true
			child.ZIndex = 45
		end
	end

	numberLabel.Position = UDim2.new(0, 0, 0.45, 0)
	numberLabel.Size = UDim2.new(1, 0, 0.45, 0)
	numberLabel.TextScaled = true
	numberLabel.ZIndex = 60
end

local function applyMobileLayout()
	mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	-- 0.58 impingea cardul spre dreapta, aproape de butoanele Starter
	-- Pack/Rebirth/Daily Rewards -- 0.48 il centreaza mai spre stanga.
	mainFrame.Position = UDim2.new(0.48, 0, 0.50, 0)
	mainFrame.Size = UDim2.new(0.52, 0, 0.62, 0)

	header.Position = UDim2.new(0, 0, 0, 0)
	header.Size = UDim2.new(1, 0, 0.15, 0)

	if currentFrame then
		currentFrame.Position = UDim2.new(0.06, 0, 0.18, 0)
		currentFrame.Size = UDim2.new(0.40, 0, 0.20, 0)
	end

	if nextFrame then
		nextFrame.Position = UDim2.new(0.54, 0, 0.18, 0)
		nextFrame.Size = UDim2.new(0.40, 0, 0.20, 0)
	end

	if currentPerksFrame then
		currentPerksFrame.Position = UDim2.new(0.06, 0, 0.43, 0)
		currentPerksFrame.Size = UDim2.new(0.40, 0, 0.38, 0)
	end

	if nextPerksFrame then
		nextPerksFrame.Position = UDim2.new(0.54, 0, 0.43, 0)
		nextPerksFrame.Size = UDim2.new(0.40, 0, 0.38, 0)
	end

	if costBox then
		costBox.Position = UDim2.new(0.18, 0, 0.81, 0)
		costBox.Size = UDim2.new(0.64, 0, 0.08, 0)
		costBox.ClipsDescendants = false
	end

	if costLabel then
		costLabel.Position = UDim2.new(0, 0, 0, 0)
		costLabel.Size = UDim2.new(1, 0, 1, 0)
		costLabel.TextScaled = false
		costLabel.TextSize = 12
		costLabel.Visible = true
		costLabel.ZIndex = 100
	end

	-- TextSize fix (12) + TextWrapped nu garanteaza ca incap toate liniile --
	-- la level 5 sunt 5 randuri (titlu + gol + 3 perk-uri, inclusiv NPC
	-- Speed), care puteau depasi cutia si sa se taie ultimul rand. TextScaled
	-- micsoreaza automat textul cat sa incapa tot, garantat.
	if currentPerksLabel then
		currentPerksLabel.TextScaled = true
		currentPerksLabel.TextWrapped = true
	end

	if nextPerksLabel then
		nextPerksLabel.TextScaled = true
		nextPerksLabel.TextWrapped = true
	end

	if upgradeButton then
		upgradeButton.Position = UDim2.new(0.16, 0, 0.91, 0)
		upgradeButton.Size = UDim2.new(0.68, 0, 0.09, 0)
		upgradeButton.TextScaled = true
		upgradeButton.ZIndex = 50
	end

	fixLevelBox(currentFrame, currentNumber)
	fixLevelBox(nextFrame, nextNumber)
end

local function applyPCLayout()
	mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	mainFrame.Size = UDim2.new(0.65, 0, 0.72, 0)

	header.Position = UDim2.new(0, 0, 0, 0)
	header.Size = UDim2.new(1, 0, 0.14, 0)

	if currentFrame then
		currentFrame.Position = UDim2.new(0.07, 0, 0.17, 0)
		currentFrame.Size = UDim2.new(0.40, 0, 0.22, 0)
	end

	if nextFrame then
		nextFrame.Position = UDim2.new(0.53, 0, 0.17, 0)
		nextFrame.Size = UDim2.new(0.40, 0, 0.22, 0)
	end

	if currentPerksFrame then
		currentPerksFrame.Position = UDim2.new(0.07, 0, 0.43, 0)
		currentPerksFrame.Size = UDim2.new(0.40, 0, 0.32, 0)
	end

	if nextPerksFrame then
		nextPerksFrame.Position = UDim2.new(0.53, 0, 0.43, 0)
		nextPerksFrame.Size = UDim2.new(0.40, 0, 0.32, 0)
	end

	if costBox then
		costBox.Position = UDim2.new(0.25, 0, 0.78, 0)
		costBox.Size = UDim2.new(0.50, 0, 0.08, 0)
		costBox.ClipsDescendants = false
	end

	if costLabel then
		costLabel.Position = UDim2.new(0, 0, 0, 0)
		costLabel.Size = UDim2.new(1, 0, 1, 0)
		costLabel.TextScaled = true
		costLabel.Visible = true
		costLabel.ZIndex = 100
	end

	if upgradeButton then
		upgradeButton.Position = UDim2.new(0.12, 0, 0.88, 0)
		upgradeButton.Size = UDim2.new(0.76, 0, 0.10, 0)
		upgradeButton.TextScaled = true
		upgradeButton.ZIndex = 50
	end

	fixLevelBox(currentFrame, currentNumber)
	fixLevelBox(nextFrame, nextNumber)

	if currentPerksLabel then
		currentPerksLabel.TextScaled = false
		currentPerksLabel.TextSize = 22
	end

	if nextPerksLabel then
		nextPerksLabel.TextScaled = false
		nextPerksLabel.TextSize = 22
	end

	if costLabel then
		costLabel.TextScaled = false
		costLabel.TextSize = 24
	end

	if upgradeButton then
		upgradeButton.TextScaled = false
		upgradeButton.TextSize = 26
	end
end

local function applyLayout()
	if isMobile then
		applyMobileLayout()
	else
		applyPCLayout()
	end
end

local function updateUI(level)
	currentLevel = level
	local nextLevel = math.min(level + 1, MAX_LEVEL)

	if currentNumber then
		currentNumber.Text = tostring(level)
	end

	if nextNumber then
		nextNumber.Text = level >= MAX_LEVEL and "MAX" or tostring(nextLevel)
	end

	if costLabel then
		if level >= MAX_LEVEL then
			costLabel.Text = "💰 MAX LEVEL"
		else
			costLabel.Text = "💰 Upgrade Cost: $" .. tostring(Economy.StandUpgradeCosts[level] or 0)
		end
	end

	if currentPerksLabel then
		currentPerksLabel.Text = "📋 CURRENT PERKS\n\n" .. (currentPerks[level] or "Base Stand")
	end

	if nextPerksLabel then
		nextPerksLabel.Text = "✨ NEXT LEVEL PERKS\n\n" .. (nextPerks[level] or "MAX LEVEL")
	end

	if upgradeButton then
		upgradeButton.Text = level >= MAX_LEVEL and "MAX LEVEL" or "UPGRADE"
		upgradeButton.Active = level < MAX_LEVEL
		upgradeButton.AutoButtonColor = level < MAX_LEVEL
	end

	applyLayout()
end

mainFrame.Visible = false
applyLayout()

closeButton.Activated:Connect(function()
	mainFrame.Visible = false
end)

-- ================= Zona galbena de la stand =================
-- Cercul galben e desenat pe server (StandManager.server.luau, "ClaimZone",
-- copil al Base-ului standului tau) -- aici doar verificam periodic distanta
-- pana la el si aratam/ascundem panoul automat. Deschide DOAR la intrare (nu
-- forteaza redeschiderea daca inchizi manual cat timp esti tot inauntru) si
-- inchide mereu la iesire.
local ZONE_CHECK_INTERVAL = 0.3
local zoneCheckTimer = 0
local wasInOwnZone = false

local function findOwnClaimZone()
	local standsFolder = Workspace:FindFirstChild("GeneratedStands")
	if not standsFolder then
		return nil
	end

	for _, stand in ipairs(standsFolder:GetChildren()) do
		if stand:GetAttribute("OwnerUserId") == player.UserId then
			local base = stand:FindFirstChild("Base")
			return base and base:FindFirstChild("ClaimZone")
		end
	end

	return nil
end

RunService.Heartbeat:Connect(function(dt)
	zoneCheckTimer += dt
	if zoneCheckTimer < ZONE_CHECK_INTERVAL then
		return
	end
	zoneCheckTimer = 0

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local zone = rootPart and findOwnClaimZone()

	local inZone = false
	if zone then
		local flatOffset = Vector2.new(rootPart.Position.X - zone.Position.X, rootPart.Position.Z - zone.Position.Z)
		inZone = flatOffset.Magnitude <= (zone.Size.Y / 2)
	end

	if inZone and not wasInOwnZone then
		mainFrame.Visible = true
		applyLayout()
		requestStandLevelEvent:FireServer()
	elseif not inZone and wasInOwnZone then
		mainFrame.Visible = false
	end

	wasInOwnZone = inZone
end)

-- Acelasi flag comun folosit de Starter Pack/Rebirth/Daily Rewards/Token
-- Shop/Inventory/Store -- cat timp Stand Upgrade e deschis, celelalte
-- butoane de pe ecran (inclusiv grila Inventory/Bank/Market/Stand/Store/Pets)
-- se ascund.
mainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
	player:SetAttribute("ShopModalOpen", mainFrame.Visible)
end)

upgradeButton.Activated:Connect(function()
	if currentLevel < MAX_LEVEL then
		upgradeStandEvent:FireServer()
	end
end)

updateStandLevelEvent.OnClientEvent:Connect(function(level)
	updateUI(level)
end)

requestStandLevelEvent:FireServer()]]></ProtectedString>
