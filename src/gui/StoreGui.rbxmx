					</Properties>
					<Item class="LocalScript" referent="RBX6263F8A664FB45F4BABF7A6E3FF87AF2">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local button = script.Parent

local GAMEPASS_ID = 1899734044 -- +100 Inventory Gamepass

local function setOwned()
	button.Text = "Owned"
	button.Active = false
	button.AutoButtonColor = false
end

local function checkOwned()
	local success, ownsPass = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, GAMEPASS_ID)
	end)

	if success and ownsPass then
		setOwned()
	else
		button.Text = "Buy"
		button.Active = true
		button.AutoButtonColor = true
	end
end

checkOwned()

button.MouseButton1Click:Connect(function()
	local success, ownsPass = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, GAMEPASS_ID)
	end)

	if success and ownsPass then
		setOwned()
	else
		MarketplaceService:PromptGamePassPurchase(player, GAMEPASS_ID)
	end
end)

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(purchasePlayer, gamePassId, wasPurchased)
	if purchasePlayer == player and gamePassId == GAMEPASS_ID and wasPurchased then
		setOwned()
	end
end)]]></ProtectedString>
