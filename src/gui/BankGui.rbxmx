		<Item class="LocalScript" referent="RBXEBD16FBD765347A1B5C49D8235EC3585">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local depositEvent = remotes:WaitForChild("DepositMoney")
local withdrawEvent = remotes:WaitForChild("WithdrawMoney")
local getBankData = remotes:WaitForChild("GetBankData")

local bankGui = script.Parent
local mainFrame = bankGui:WaitForChild("MainFrame")

local header = mainFrame:WaitForChild("Header")
local closeButton = header:WaitForChild("CloseButton")

local cashBox = mainFrame:WaitForChild("CashBox")
local bankBox = mainFrame:WaitForChild("BankBox")
local amountBox = mainFrame:WaitForChild("AmountBox")
local depositButton = mainFrame:WaitForChild("DepositButton")
local withdrawButton = mainFrame:WaitForChild("WithdrawButton")

local cashLabel = cashBox:WaitForChild("CashLabel")
local bankLabel = bankBox:WaitForChild("BankLabel")

local mainHud = playerGui:WaitForChild("MainHUD")
local bottomBar = mainHud:WaitForChild("BottomBar")
local row1 = bottomBar:WaitForChild("Row1")
local bankButton = row1:WaitForChild("BankButton")

-- TouchEnabled singur nu e de incredere -- verificam si dimensiunea reala a
-- ecranului (acelasi fix aplicat si la celelalte GUI-uri).
local function computeIsMobile()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	return UserInputService.TouchEnabled or viewport.X < 700 or viewport.Y < 500
end

local isMobile = computeIsMobile()

local function applyLayout()
	mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)

	header.Position = UDim2.new(0, 0, 0, 0)

	cashLabel.TextScaled = false
	bankLabel.TextScaled = false
	amountBox.TextScaled = false
	depositButton.TextScaled = false
	withdrawButton.TextScaled = false

	cashLabel.TextSize = 28
	bankLabel.TextSize = 28

	amountBox.TextSize = 22
	amountBox.PlaceholderText = "Enter amount..."

	depositButton.TextSize = 24
	withdrawButton.TextSize = 24

	if isMobile then
		mainFrame.Position = UDim2.new(0.53, 0, 0.50, 0)
		mainFrame.Size = UDim2.new(0.56, 0, 0.64, 0)

		header.Size = UDim2.new(1, 0, 0.14, 0)

		cashBox.Position = UDim2.new(0.05, 0, 0.18, 0)
		cashBox.Size = UDim2.new(0.90, 0, 0.14, 0)

		bankBox.Position = UDim2.new(0.05, 0, 0.36, 0)
		bankBox.Size = UDim2.new(0.90, 0, 0.14, 0)

		amountBox.Position = UDim2.new(0.05, 0, 0.55, 0)
		amountBox.Size = UDim2.new(0.90, 0, 0.10, 0)

		depositButton.Position = UDim2.new(0.05, 0, 0.73, 0)
		depositButton.Size = UDim2.new(0.42, 0, 0.11, 0)

		withdrawButton.Position = UDim2.new(0.53, 0, 0.73, 0)
		withdrawButton.Size = UDim2.new(0.42, 0, 0.11, 0)
	else
		mainFrame.Position = UDim2.new(0.50, 0, 0.50, 0)
		mainFrame.Size = UDim2.new(0.48, 0, 0.66, 0)

		header.Size = UDim2.new(1, 0, 0.15, 0)

		cashBox.Position = UDim2.new(0.05, 0, 0.18, 0)
		cashBox.Size = UDim2.new(0.90, 0, 0.15, 0)

		bankBox.Position = UDim2.new(0.05, 0, 0.37, 0)
		bankBox.Size = UDim2.new(0.90, 0, 0.15, 0)

		amountBox.Position = UDim2.new(0.05, 0, 0.58, 0)
		amountBox.Size = UDim2.new(0.90, 0, 0.11, 0)

		depositButton.Position = UDim2.new(0.05, 0, 0.78, 0)
		depositButton.Size = UDim2.new(0.42, 0, 0.12, 0)

		withdrawButton.Position = UDim2.new(0.53, 0, 0.78, 0)
		withdrawButton.Size = UDim2.new(0.42, 0, 0.12, 0)
	end
end

mainFrame.Visible = false
applyLayout()

local function formatMoney(amount)
	return "$" .. tostring(amount):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

-- Retinem ultimele valori cunoscute de Cash/Bank, ca sa putem plafona local
-- suma introdusa (fara sa mai asteptam un round-trip suplimentar la server).
local lastCash = 0
local lastBank = 0

local function refresh()
	local data = getBankData:InvokeServer()

	lastCash = data.Cash
	lastBank = data.Bank

	cashLabel.Text = "💵 Cash: " .. formatMoney(data.Cash)
	bankLabel.Text = "🏦 Bank: " .. formatMoney(data.Bank)
end

-- Plafonare LIVE, direct in caseta "Enter amount", nu doar la apasarea unui
-- buton -- daca scrie mai mult decat maximul posibil (cash sau banca,
-- oricare e mai mare), caseta se corecteaza imediat, cat tasteaza.
local isClampingText = false

amountBox:GetPropertyChangedSignal("Text"):Connect(function()
	if isClampingText then
		return
	end

	local amount = tonumber(amountBox.Text)
	if not amount then
		return
	end

	local maxPossible = math.max(lastCash, lastBank)

	if amount > maxPossible then
		isClampingText = true
		amountBox.Text = tostring(maxPossible)
		isClampingText = false
	end
end)

bankButton.Activated:Connect(function()
	mainFrame.Visible = not mainFrame.Visible

	if mainFrame.Visible then
		applyLayout()
		refresh()
	end
end)

closeButton.Activated:Connect(function()
	mainFrame.Visible = false
end)

-- Acelasi flag comun folosit de Starter Pack/Rebirth/Daily Rewards/Token
-- Shop/Inventory/Store/Stand Upgrade/Pets -- cat timp Bank e deschis,
-- celelalte butoane de pe ecran se ascund.
mainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
	player:SetAttribute("ShopModalOpen", mainFrame.Visible)
end)

depositButton.Activated:Connect(function()
	local amount = tonumber(amountBox.Text)

	if amount then
		-- Daca a scris mai mult decat are in Cash, plafonam la maximul
		-- disponibil (nu doar refuzam sau lasam serverul sa taie tacut).
		if amount > lastCash then
			amount = lastCash
			amountBox.Text = tostring(amount)
		end

		depositEvent:FireServer(amount)
		task.wait(0.1)
		refresh()
		amountBox.Text = ""
	end
end)

withdrawButton.Activated:Connect(function()
	local amount = tonumber(amountBox.Text)

	if amount then
		-- Idem, dar plafonat la ce are in Bank, nu in Cash.
		if amount > lastBank then
			amount = lastBank
			amountBox.Text = tostring(amount)
		end

		withdrawEvent:FireServer(amount)
		task.wait(0.1)
		refresh()
		amountBox.Text = ""
	end
end)

refresh()]]></ProtectedString>
