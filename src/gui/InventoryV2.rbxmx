			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local INVENTORY_PASS_ID = 1899734044
local DEFAULT_MAX_INVENTORY = 50
local PASS_MAX_INVENTORY = 150
local VIP_EXTRA_SLOTS = 25

local ownsInventoryPass = false
local lastInventoryCount = 0

-- TouchEnabled singur nu e de incredere (poate fi false pe telefon in
-- anumite ferestre/Studio) -- verificam si dimensiunea reala a ecranului,
-- acelasi fix aplicat si la EggShopGui/StoreGui/TradeGui.
local function computeIsMobile()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	return UserInputService.TouchEnabled or viewport.X < 700 or viewport.Y < 500
end

-- BUG gasit la audit: isMobile decidea aici, o singura data, daca se
-- CONSTRUIESTE deloc UI-ul de mobil (MobileDetailsFrame + butoane, mai jos)
-- -- nu doar cum arata. Pe un ecran care raporteaza o rezolutie implicita/
-- gresita la primul frame (acelasi bug gasit si reparat la EggShopGui),
-- UI-ul de mobil putea sa nu existe deloc daca telefonul/fereastra mica e
-- detectata ca desktop la acel moment. Asteptam un ViewportSize real inainte
-- sa decidem.
local function waitForRealViewport()
	local attempts = 0

	while attempts < 30 do
		local camera = workspace.CurrentCamera

		if camera and camera.ViewportSize.Magnitude > 1 then
			return
		end

		task.wait(0.1)
		attempts += 1
	end
end

waitForRealViewport()

local isMobile = computeIsMobile()

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local requestInventory = remotes:WaitForChild("RequestInventory")
local showInventory = remotes:WaitForChild("ShowInventory")
local sellSelectedItem = remotes:WaitForChild("SellSelectedItem")

local inventoryGui = script.Parent
local mainFrame = inventoryGui:WaitForChild("MainFrame")
local closeButton = mainFrame:WaitForChild("Header"):WaitForChild("CloseButton")

local itemsArea = mainFrame:WaitForChild("ItemsArea")
local itemsGrid = itemsArea:WaitForChild("ItemsGrid")
local gridLayout = itemsGrid:FindFirstChildOfClass("UIGridLayout")

local itemTemplate = mainFrame:FindFirstChild("ItemTemplate", true)

local detailsArea = mainFrame:WaitForChild("DetailsArea")
local selectedIcon = detailsArea:FindFirstChild("SelectedIcon", true)

if not selectedIcon then
	warn("SelectedIcon nu a fost gasit")
	return
end

local selectedName = detailsArea:WaitForChild("SelectedName")
local selectedCategory = detailsArea:WaitForChild("SelectedCategory")
local selectedRarity = detailsArea:WaitForChild("SelectedRarity")
local selectedPrice = detailsArea:WaitForChild("SelectedPrice")
local sellButton = detailsArea:WaitForChild("SellButton")

-- Fortam proprietatile astea direct din script, la runtime -- editarile
-- facute doar in fisierul .rbxmx (Text/Font/TextScaled/Alignment) nu se vedeau
-- corect in joc de mai multe ori la rand, semn ca instanta asta ramasese cu
-- valori vechi undeva (sincronizare/cache Rojo). Setandu-le aici, in script,
-- sunt garantat corecte de fiecare data cand jucatorul deschide Inventory,
-- indiferent de orice a mai ramas cache-uit pe obiectul din XML.
sellButton.Text = "SELL"
sellButton.Font = Enum.Font.LuckiestGuy
-- TextScaled parea sa calculeze un font mult mai mic decat ar trebui pentru
-- cutia asta (motiv neclar -- posibil o particularitate a fontului Luckiest
-- Guy la un raport lat/scund) -- trecut pe TextSize fix, mare, garantat
-- vizibil, in loc sa mai depindem de auto-scale.
sellButton.TextScaled = false
sellButton.TextSize = 28
sellButton.TextWrapped = false
sellButton.TextXAlignment = Enum.TextXAlignment.Center
sellButton.TextYAlignment = Enum.TextYAlignment.Center
sellButton.TextColor3 = Color3.fromRGB(255, 255, 255)

-- Colturi rotunjite, la fel ca la cardul principal (MainFrame), nu drepte.
local sellButtonCorner = sellButton:FindFirstChildOfClass("UICorner")
if not sellButtonCorner then
	sellButtonCorner = Instance.new("UICorner")
	sellButtonCorner.Parent = sellButton
end
sellButtonCorner.CornerRadius = UDim.new(0, 14)

local sellButtonPadding = sellButton:FindFirstChildOfClass("UIPadding")
if not sellButtonPadding then
	sellButtonPadding = Instance.new("UIPadding")
	sellButtonPadding.Parent = sellButton
end
sellButtonPadding.PaddingLeft = UDim.new(0, 4)
sellButtonPadding.PaddingRight = UDim.new(0, 4)
sellButtonPadding.PaddingTop = UDim.new(0, 5)
sellButtonPadding.PaddingBottom = UDim.new(0, 1)
local mobileDetailsFrame = nil
local mobileIcon = nil
local mobileName = nil
local mobileCategory = nil
local mobileRarity = nil
local mobilePrice = nil
local mobileSellButton = nil
local mobileBackButton = nil

if isMobile then
	mobileDetailsFrame = Instance.new("Frame")
	mobileDetailsFrame.Name = "MobileDetailsFrame"
	mobileDetailsFrame.Parent = mainFrame
	mobileDetailsFrame.Visible = false
	mobileDetailsFrame.BackgroundColor3 = Color3.fromRGB(18, 24, 36)
	mobileDetailsFrame.Size = UDim2.new(0.88, 0, 0.78, 0)
	mobileDetailsFrame.Position = UDim2.new(0.06, 0, 0.16, 0)
	mobileDetailsFrame.ZIndex = 300

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 18)
	corner.Parent = mobileDetailsFrame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(60, 150, 255)
	stroke.Thickness = 3
	stroke.Parent = mobileDetailsFrame

	mobileBackButton = Instance.new("TextButton")
	mobileBackButton.Parent = mobileDetailsFrame
	mobileBackButton.Text = "← BACK"
	mobileBackButton.Size = UDim2.new(0.28, 0, 0.10, 0)
	mobileBackButton.Position = UDim2.new(0.04, 0, 0.04, 0)
	mobileBackButton.BackgroundColor3 = Color3.fromRGB(45, 55, 75)
	mobileBackButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	mobileBackButton.TextScaled = true
	mobileBackButton.Font = Enum.Font.GothamBold
	mobileBackButton.ZIndex = 301

	mobileIcon = Instance.new("ImageLabel")
	mobileIcon.Parent = mobileDetailsFrame
	mobileIcon.BackgroundTransparency = 1
	mobileIcon.Size = UDim2.new(0.48, 0, 0.34, 0)
	mobileIcon.Position = UDim2.new(0.26, 0, 0.14, 0)
	mobileIcon.ScaleType = Enum.ScaleType.Fit
	mobileIcon.ZIndex = 301

	mobileName = Instance.new("TextLabel")
	mobileName.Parent = mobileDetailsFrame
	mobileName.BackgroundTransparency = 1
	mobileName.Size = UDim2.new(0.90, 0, 0.09, 0)
	mobileName.Position = UDim2.new(0.05, 0, 0.49, 0)
	mobileName.TextColor3 = Color3.fromRGB(255, 255, 255)
	mobileName.TextScaled = true
	mobileName.Font = Enum.Font.GothamBlack
	mobileName.ZIndex = 301

	mobileRarity = Instance.new("TextLabel")
	mobileRarity.Parent = mobileDetailsFrame
	mobileRarity.BackgroundTransparency = 1
	mobileRarity.Size = UDim2.new(0.90, 0, 0.08, 0)
	mobileRarity.Position = UDim2.new(0.05, 0, 0.59, 0)
	mobileRarity.TextScaled = true
	mobileRarity.Font = Enum.Font.GothamBold
	mobileRarity.ZIndex = 301

	mobileCategory = Instance.new("TextLabel")
	mobileCategory.Parent = mobileDetailsFrame
	mobileCategory.BackgroundTransparency = 1
	mobileCategory.Size = UDim2.new(0.90, 0, 0.07, 0)
	mobileCategory.Position = UDim2.new(0.05, 0, 0.67, 0)
	mobileCategory.TextColor3 = Color3.fromRGB(140, 165, 200)
	mobileCategory.TextScaled = true
	mobileCategory.Font = Enum.Font.GothamBold
	mobileCategory.ZIndex = 301

	mobilePrice = Instance.new("TextLabel")
	mobilePrice.Parent = mobileDetailsFrame
	mobilePrice.BackgroundTransparency = 1
	mobilePrice.Size = UDim2.new(0.90, 0, 0.08, 0)
	mobilePrice.Position = UDim2.new(0.05, 0, 0.76, 0)
	mobilePrice.TextColor3 = Color3.fromRGB(255, 255, 255)
	mobilePrice.TextScaled = true
	mobilePrice.Font = Enum.Font.GothamBold
	mobilePrice.ZIndex = 301

	mobileSellButton = Instance.new("TextButton")
	mobileSellButton.Parent = mobileDetailsFrame
	mobileSellButton.Text = "SELL"
	mobileSellButton.Size = UDim2.new(0.70, 0, 0.10, 0)
	mobileSellButton.Position = UDim2.new(0.15, 0, 0.87, 0)
	mobileSellButton.BackgroundColor3 = Color3.fromRGB(45, 210, 95)
	mobileSellButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	mobileSellButton.TextScaled = true
	mobileSellButton.TextWrapped = false
	mobileSellButton.TextXAlignment = Enum.TextXAlignment.Center
	mobileSellButton.TextYAlignment = Enum.TextYAlignment.Center
	mobileSellButton.Font = Enum.Font.LuckiestGuy
	mobileSellButton.ZIndex = 301

	local mobileSellCorner = Instance.new("UICorner")
	mobileSellCorner.CornerRadius = UDim.new(0, 14)
	mobileSellCorner.Parent = mobileSellButton
end

local inventoryCountLabel = mainFrame:FindFirstChild("InventoryCountLabel", true)
if not inventoryCountLabel then
	warn("InventoryCountLabel nu a fost gasit")
	return
end

local upgradeInventoryButton = itemsArea:FindFirstChild("UpgradeInventoryButton")

if not upgradeInventoryButton then
	upgradeInventoryButton = Instance.new("TextButton")
	upgradeInventoryButton.Name = "UpgradeInventoryButton"
	upgradeInventoryButton.Parent = itemsArea
end

local upgradePopup = mainFrame:WaitForChild("InventoryUpgradePopup")
local buyUpgradeButton = upgradePopup:WaitForChild("BuyButton")
local cancelUpgradeButton = upgradePopup:WaitForChild("CancelButton")

-- UI layout PC / Mobile
if isMobile then
	-- 0.62 x 0.68 din ecran iesea foarte mare pe telefon (landscape) --
	-- 0.42 x 0.55 ramane usor de folosit fara sa acopere tot ecranul.
	mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	mainFrame.Position = UDim2.new(0.55, 0, 0.52, 0)
	mainFrame.Size = UDim2.new(0.42, 0, 0.55, 0)

	itemsArea.Size = UDim2.new(0.95, 0, 0.70, 0)
	itemsArea.Position = UDim2.new(0.025, 0, 0.22, 0)
	if gridLayout then
		gridLayout.CellSize = UDim2.new(0, 75, 0, 75)
		gridLayout.CellPadding = UDim2.new(0, 6, 0, 6)
	end
	detailsArea.Size = UDim2.new(0.36, 0, 0.72, 0)
	detailsArea.Position = UDim2.new(0.61, 0, 0.20, 0)

	local selectedIconFrame = selectedIcon.Parent
	selectedIconFrame.Size = UDim2.new(0.82, 0, 0.38, 0)
	selectedIconFrame.Position = UDim2.new(0.09, 0, 0.05, 0)

	selectedIcon.Size = UDim2.new(0.82, 0, 0.82, 0)
	selectedIcon.Position = UDim2.new(0.09, 0, 0.09, 0)

	selectedName.Size = UDim2.new(0.90, 0, 0.09, 0)
	selectedName.Position = UDim2.new(0.05, 0, 0.47, 0)
	selectedName.TextScaled = true

	selectedRarity.Size = UDim2.new(0.90, 0, 0.08, 0)
	selectedRarity.Position = UDim2.new(0.05, 0, 0.60, 0)
	selectedRarity.TextScaled = true

	selectedPrice.Size = UDim2.new(0.90, 0, 0.08, 0)
	selectedPrice.Position = UDim2.new(0.05, 0, 0.69, 0)
	selectedPrice.TextScaled = true

	sellButton.Size = UDim2.new(0.80, 0, 0.10, 0)
	sellButton.Position = UDim2.new(0.10, 0, 0.82, 0)

	detailsArea.Visible = false
else
	mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	mainFrame.Size = UDim2.new(0.55, 0, 0.65, 0)
	if gridLayout then
		gridLayout.CellSize = UDim2.new(0, 115, 0, 115)
		gridLayout.CellPadding = UDim2.new(0, 8, 0, 8)
	end

	detailsArea.Visible = true
end

upgradeInventoryButton.Text = "+"
upgradeInventoryButton.Size = UDim2.new(0, 40, 0, 40)
upgradeInventoryButton.Position = UDim2.new(1, 10, 0, -8)
upgradeInventoryButton.BackgroundColor3 = Color3.fromRGB(40, 220, 80)
upgradeInventoryButton.TextColor3 = Color3.fromRGB(255, 255, 255)
upgradeInventoryButton.Font = Enum.Font.GothamBold
upgradeInventoryButton.TextScaled = true
upgradeInventoryButton.Visible = true
upgradeInventoryButton.ZIndex = 999

if not upgradeInventoryButton:FindFirstChild("UICorner") then
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = upgradeInventoryButton
end

local selectedItemId = nil
local selectedSlot = nil

itemTemplate.Visible = false
upgradePopup.Visible = false

local rarityColors = {
	Common = Color3.fromRGB(170, 170, 170),
	Uncommon = Color3.fromRGB(60, 255, 60),
	Rare = Color3.fromRGB(0, 170, 255),
	Epic = Color3.fromRGB(180, 0, 255),
	Legendary = Color3.fromRGB(255, 180, 0)
}

local function getMaxInventory()
	local maxInventory = ownsInventoryPass and PASS_MAX_INVENTORY or DEFAULT_MAX_INVENTORY

	if player:GetAttribute("IsVIP") then
		maxInventory += VIP_EXTRA_SLOTS
	end

	return maxInventory
end

local function updateInventoryCount(count)
	local maxInventory = getMaxInventory()
	inventoryCountLabel.Text = "Inventory: " .. tostring(count) .. "/" .. tostring(maxInventory)

	upgradeInventoryButton.Visible = not ownsInventoryPass
end

local function checkInventoryPass()
	local success, result = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, INVENTORY_PASS_ID)
	end)

	ownsInventoryPass = success and result or false
	updateInventoryCount(lastInventoryCount)
end

local function clearItems()
	for _, child in ipairs(itemsGrid:GetChildren()) do
		if child:IsA("Frame") and child.Name ~= "ItemTemplate" then
			child:Destroy()
		end
	end
end

local function clearDetails()
	selectedItemId = nil
	selectedSlot = nil

	selectedIcon.Image = ""
	selectedName.Text = "SELECT AN ITEM"
	selectedCategory.Text = "CATEGORY: -"
	selectedRarity.Text = "RARITY: -"
	selectedRarity.TextColor3 = Color3.fromRGB(180, 180, 180)
	selectedPrice.Text = "BOUGHT: $0"

	if isMobile and mobileDetailsFrame then
		mobileDetailsFrame.Visible = false
	end
end

local function selectSlot(slot, item)
	if isMobile then
		detailsArea.Visible = false
		mobileDetailsFrame.Visible = true
	end

	selectedItemId = item.Id or item.ItemId or item.Name or item.ItemName
	if selectedSlot then
		local oldStroke = selectedSlot:FindFirstChild("UIStroke")
		if oldStroke then
			oldStroke.Thickness = 2
			oldStroke.Color = Color3.fromRGB(80, 150, 255)
		end
	end

	selectedSlot = slot

	local stroke = slot:FindFirstChild("UIStroke")
	if stroke then
		stroke.Thickness = 3
		stroke.Color = Color3.fromRGB(255, 255, 255)
	end

	local rarity = item.Rarity or "Common"
	local rarityColor = rarityColors[rarity] or Color3.fromRGB(180, 180, 180)

	local imageStroke = selectedIcon.Parent:FindFirstChild("UIStroke")
	if imageStroke then
		imageStroke.Color = rarityColor
	end

	selectedIcon.Image = item.Image or ""
	selectedName.Text = string.upper(item.ItemName or "Unknown Item")
	selectedCategory.Text = "CATEGORY: " .. (item.Category or "Misc")
	selectedRarity.Text = "RARITY: " .. rarity
	selectedRarity.TextColor3 = rarityColor
	selectedPrice.Text = "BOUGHT: $" .. tostring(item.BuyPrice or 0)
	if isMobile and mobileDetailsFrame then
		mobileIcon.Image = item.Image or ""
		mobileName.Text = string.upper(item.ItemName or "Unknown Item")
		mobileCategory.Text = "CATEGORY: " .. (item.Category or "Misc")
		mobileRarity.Text = "RARITY: " .. rarity
		mobileRarity.TextColor3 = rarityColor
		mobilePrice.Text = "BOUGHT: $" .. tostring(item.BuyPrice or 0)
	end

end


local function showItems(items)
	lastInventoryCount = #items
	checkInventoryPass()

	clearItems()
	clearDetails()

	for index, item in ipairs(items) do
		local slot = itemTemplate:Clone()
		slot.Name = "Slot_" .. index
		slot.Size = isMobile and UDim2.new(0, 75, 0, 75) or UDim2.new(0, 115, 0, 115)
		slot.BackgroundColor3 = Color3.fromRGB(22, 28, 40)
		slot.BackgroundTransparency = 0
		slot.Active = true
		slot.Visible = true
		slot.Parent = itemsGrid

		local rarity = item.Rarity or "Common"
		local rarityColor = rarityColors[rarity] or Color3.fromRGB(80, 150, 255)

		local slotStroke = slot:FindFirstChild("UIStroke")
		if slotStroke then
			slotStroke.Color = rarityColor
			slotStroke.Thickness = 2
		end

		local itemIcon = slot:FindFirstChild("ItemIcon", true)
		if not itemIcon then
			itemIcon = Instance.new("ImageLabel")
			itemIcon.Name = "ItemIcon"
			itemIcon.Parent = slot
		end

		itemIcon.Image = item.Image or ""
		itemIcon.Visible = true
		itemIcon.ImageTransparency = 0
		itemIcon.BackgroundTransparency = 1
		itemIcon.Size = UDim2.new(0.78, 0, 0.78, 0)
		itemIcon.Position = UDim2.new(0.11, 0, 0.11, 0)
		itemIcon.ScaleType = Enum.ScaleType.Fit
		itemIcon.ZIndex = 10

		local itemName = slot:FindFirstChild("ItemName", true)
		if itemName then
			itemName.Visible = false
		end

		slot.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				selectSlot(slot, item)
			end
		end)
	end
end

showInventory.OnClientEvent:Connect(showItems)

-- Acelasi flag comun folosit de Starter Pack/Rebirth/Daily Rewards/Token
-- Shop -- cat timp Inventory e deschis, butoanele alea de pe ecran se
-- ascund (si invers, redeschiderea lor e blocata cat timp flag-ul e activ).
mainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
	player:SetAttribute("ShopModalOpen", mainFrame.Visible)

	if mainFrame.Visible then
		requestInventory:FireServer()
		checkInventoryPass()
	end
end)

closeButton.Activated:Connect(function()
	mainFrame.Visible = false
	upgradePopup.Visible = false

	if isMobile then
		detailsArea.Visible = false
	end
end)

sellButton.Activated:Connect(function()
	if selectedItemId then
		sellSelectedItem:FireServer(selectedItemId)
		task.wait(0.2)
		requestInventory:FireServer()
	else
		warn("Nu ai selectat niciun item")
	end
end)

upgradeInventoryButton.Activated:Connect(function()
	if ownsInventoryPass then
		return
	end

	upgradePopup.Visible = true
end)

buyUpgradeButton.Activated:Connect(function()
	MarketplaceService:PromptGamePassPurchase(player, INVENTORY_PASS_ID)
end)

cancelUpgradeButton.Activated:Connect(function()
	upgradePopup.Visible = false
end)
if isMobile and mobileBackButton then
	mobileBackButton.Activated:Connect(function()
		mobileDetailsFrame.Visible = false
	end)
end

if isMobile and mobileSellButton then
	mobileSellButton.Activated:Connect(function()
		if selectedItemId then
			sellSelectedItem:FireServer(selectedItemId)
			mobileDetailsFrame.Visible = false
			task.wait(0.2)
			requestInventory:FireServer()
		end
	end)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(purchasePlayer, gamePassId, wasPurchased)
	if purchasePlayer ~= player then return end
	if gamePassId ~= INVENTORY_PASS_ID then return end

	if wasPurchased then
		ownsInventoryPass = true
		upgradePopup.Visible = false
		updateInventoryCount(lastInventoryCount)
	end
end)

player:GetAttributeChangedSignal("IsVIP"):Connect(function()
	updateInventoryCount(lastInventoryCount)
end)

checkInventoryPass()]]></ProtectedString>
