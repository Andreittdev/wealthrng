				<ProtectedString name="Source"><![CDATA[local inventoryGui = script.Parent

inventoryGui.DescendantAdded:Connect(function(obj)
	task.wait()

	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		if string.upper(obj.Text) == "INVENTORY" then
			obj.Visible = false
			print("Am ascuns:", obj:GetFullName())
		end
	end
end)]]></ProtectedString>
