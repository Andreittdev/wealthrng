			<Item class="LocalScript" referent="RBX648692435CC2487C8CEF5F749EF3D316">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local mainHud = script.Parent.Parent
local bottomBar = script.Parent
local cashFrame = mainHud:WaitForChild("CashFrame")

local row1 = bottomBar:WaitForChild("Row1")
local row2 = bottomBar:WaitForChild("Row2")
local row3 = bottomBar:WaitForChild("Row3")

local inventoryButton = row1:WaitForChild("InventoryButton")
local storeButton = row3:WaitForChild("StoreButton")
local itemsButton = row3:WaitForChild("ItemsButton")

local inventoryFrame = playerGui:WaitForChild("InventoryV2"):WaitForChild("MainFrame")

local storeGui = playerGui:WaitForChild("StoreGui")
local storeFrame = storeGui:WaitForChild("MainFrame")
local itemsGui = playerGui:WaitForChild("ItemsGui")
local itemsFrame = itemsGui:WaitForChild("MainFrame")

local isMobile = UserInputService.TouchEnabled
local buttonSize = isMobile and 50 or 90
local rowHeight = buttonSize

bottomBar.BackgroundTransparency = 1
bottomBar.AnchorPoint = Vector2.new(0, 0)

if isMobile then
	bottomBar.Position = UDim2.new(0, 12, 0, 45)
	bottomBar.Size = UDim2.new(0, buttonSize * 2 + 8, 0, buttonSize * 3 + 16)

	cashFrame.Position = UDim2.new(0, 12, 0, 220)
	cashFrame.Size = UDim2.new(0, 115, 0, 44)
else
	bottomBar.Position = UDim2.new(0, 22, 0.34, 0)
	bottomBar.Size = UDim2.new(0, buttonSize * 2 + 14, 0, buttonSize * 3 + 24)

	cashFrame.Position = UDim2.new(0, 22, 0.34, 295)
	cashFrame.Size = UDim2.new(0, 190, 0, 62)
end

cashFrame.Visible = true

-- ================= Friend Boost =================
-- Sub cadrul de Cash -- arata bonusul curent (0-30%, calculat pe server de
-- FriendBoostManager dupa cati prieteni Roblox ai in acelasi server) si un
-- buton verde "+" care deschide invitatia nativa de Roblox catre prieteni.
local SocialService = game:GetService("SocialService")

local friendBoostFrame = mainHud:FindFirstChild("FriendBoostFrame")
if not friendBoostFrame then
	-- Fara fundal/contur/colturi -- doar textul si butonul, plutind liber,
	-- nu intr-un chenar ca la Cash.
	friendBoostFrame = Instance.new("Frame")
	friendBoostFrame.Name = "FriendBoostFrame"
	friendBoostFrame.BackgroundTransparency = 1
	friendBoostFrame.ZIndex = 1
	friendBoostFrame.Parent = mainHud

	-- UIListLayout in loc de pozitii fixe -- butonul "+" se lipeste imediat
	-- dupa text, oricat de lung ar fi (in loc sa stea ancorat departe, la
	-- marginea din dreapta a intregului frame).
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = friendBoostFrame

	local boostLabel = Instance.new("TextLabel")
	boostLabel.Name = "BoostLabel"
	boostLabel.LayoutOrder = 1
	boostLabel.BackgroundTransparency = 1
	boostLabel.AutomaticSize = Enum.AutomaticSize.X
	boostLabel.Size = UDim2.new(0, 0, 1, 0)
	boostLabel.Text = "🤝 Friend Boost: +0% Cash"
	boostLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
	boostLabel.Font = Enum.Font.LuckiestGuy
	boostLabel.TextSize = 20
	boostLabel.TextWrapped = false
	boostLabel.TextXAlignment = Enum.TextXAlignment.Left
	boostLabel.ZIndex = 2
	boostLabel.Parent = friendBoostFrame

	local inviteButton = Instance.new("TextButton")
	inviteButton.Name = "InviteButton"
	inviteButton.LayoutOrder = 2
	inviteButton.Size = UDim2.new(0, 30, 0, 30)
	inviteButton.BackgroundColor3 = Color3.fromRGB(70, 200, 95)
	inviteButton.Text = "+"
	inviteButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	inviteButton.Font = Enum.Font.FredokaOne
	inviteButton.TextScaled = true
	inviteButton.ZIndex = 2
	inviteButton.Parent = friendBoostFrame

	Instance.new("UICorner", inviteButton).CornerRadius = UDim.new(0.3, 0)

	inviteButton.Activated:Connect(function()
		local ok = pcall(function()
			SocialService:PromptGameInvite(player)
		end)

		if not ok then
			warn("FriendBoost: nu s-a putut deschide invitatia de prieteni (SocialService indisponibil)")
		end
	end)

	local function refreshBoostLabel()
		local percent = player:GetAttribute("FriendBoostPercent") or 0
		boostLabel.Text = "🤝 Friend Boost: +" .. tostring(percent) .. "% Cash"
	end

	refreshBoostLabel()
	player:GetAttributeChangedSignal("FriendBoostPercent"):Connect(refreshBoostLabel)
end

-- Gap mai mare fata de Cash (nu mai lipit direct de el).
if isMobile then
	friendBoostFrame.Position = UDim2.new(0, 12, 0, 288)
	friendBoostFrame.Size = UDim2.new(0, 210, 0, 26)
else
	friendBoostFrame.Position = UDim2.new(0, 22, 0.34, 381)
	friendBoostFrame.Size = UDim2.new(0, 260, 0, 28)
end

friendBoostFrame.Visible = true

for _, row in ipairs({row1, row2, row3}) do
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, rowHeight)

	for _, child in ipairs(row:GetChildren()) do
		if child:IsA("TextButton") or child:IsA("ImageButton") then
			child.Active = true
			child.Selectable = true
			child.Size = UDim2.new(0, buttonSize, 0, buttonSize)

			local icon = child:FindFirstChild("ImageLabel")
			if icon then
				icon.Size = UDim2.new(0.55, 0, 0.55, 0)
				icon.Position = UDim2.new(0.225, 0, 0.08, 0)
				icon.BackgroundTransparency = 1
			end

			local text = child:FindFirstChild("ButtonText")
			if text then
				text.Visible = true
				text.BackgroundTransparency = 1
				text.TextScaled = true
				text.TextWrapped = true
				text.Size = UDim2.new(1, 0, 0.25, 0)
				text.Position = UDim2.new(0, 0, 0.68, 0)
			end
		end
	end
end

if isMobile then
	local icon = cashFrame:WaitForChild("MoneyIcon")
	local title = cashFrame:WaitForChild("CashTitle")
	local money = cashFrame:WaitForChild("MoneyLabel")

	icon.Size = UDim2.new(0.25, 0, 0.65, 0)
	icon.Position = UDim2.new(0.05, 0, 0.18, 0)

	title.Size = UDim2.new(0.45, 0, 0.32, 0)
	title.Position = UDim2.new(0.50, 0, 0.10, 0)
	title.TextScaled = true

	money.Size = UDim2.new(0.45, 0, 0.38, 0)
	money.Position = UDim2.new(0.50, 0, 0.48, 0)
	money.TextScaled = true
end

inventoryButton.Activated:Connect(function()
	inventoryFrame.Visible = not inventoryFrame.Visible
end)

storeGui.Enabled = true
storeGui.DisplayOrder = 100
storeFrame.Visible = false

local storeHitbox = storeButton:FindFirstChild("StoreHitbox")

if not storeHitbox then
	storeHitbox = Instance.new("TextButton")
	storeHitbox.Name = "StoreHitbox"
	storeHitbox.Parent = storeButton
end

storeHitbox.Size = UDim2.new(1, 0, 1, 0)
storeHitbox.Position = UDim2.new(0, 0, 0, 0)
storeHitbox.BackgroundTransparency = 1
storeHitbox.Text = ""
storeHitbox.ZIndex = 999
storeHitbox.Active = true
storeHitbox.Selectable = true

storeHitbox.Activated:Connect(function()
	storeGui.Enabled = true
	storeFrame.Visible = true
end)
itemsButton.Activated:Connect(function()
	itemsFrame.Visible = not itemsFrame.Visible
end)

-- Acelasi flag comun folosit de Starter Pack/Rebirth/Daily Rewards/Token
-- Shop/Inventory -- cat timp orice panou dintre astea e deschis, grila de
-- butoane (Inventory/Bank/Market/Stand/Store/Pets) se ascunde, ca sa nu mai
-- ramana vizibila pe langa cardul deschis.
player:GetAttributeChangedSignal("ShopModalOpen"):Connect(function()
	bottomBar.Visible = not player:GetAttribute("ShopModalOpen")
end)]]></ProtectedString>
