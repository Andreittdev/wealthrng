					<Item class="LocalScript" referent="RBX7D155A3387D94E52BB7BAEB589CABC9A">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local button = script.Parent
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local storeGui = playerGui:WaitForChild("StoreGui") -- numele GUI-ului tău de store

button.MouseButton1Click:Connect(function()
	storeGui.Enabled = not storeGui.Enabled
end)]]></ProtectedString>
