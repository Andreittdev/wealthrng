		<Item class="LocalScript" referent="RBXA42898EEBC094097AF62EE26FB04D5E7">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local player = Players.LocalPlayer

local mainHud = script.Parent
local cashFrame = mainHud:WaitForChild("CashFrame")
local moneyLabel = cashFrame:WaitForChild("MoneyLabel")

-- Peste 1 milion, scriem prescurtat (1.1M, 1.9B, 1.7T) -- altfel cifrele
-- complete nu mai incap in cadrul de Cash si se suprapun peste iconita.
local ABBREVIATIONS = {
	{1e12, "T"},
	{1e9, "B"},
	{1e6, "M"}
}

local function formatMoney(amount)
	amount = math.floor(amount)

	for _, entry in ipairs(ABBREVIATIONS) do
		local threshold, suffix = entry[1], entry[2]

		if amount >= threshold then
			local rounded = math.floor((amount / threshold) * 10) / 10
			local text = (rounded == math.floor(rounded))
				and tostring(math.floor(rounded))
				or string.format("%.1f", rounded)

			return "$" .. text .. suffix
		end
	end

	return "$" .. tostring(amount):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

local function updateMoney()
	local leaderstats = player:WaitForChild("leaderstats")
	local money = leaderstats:WaitForChild("Money")

	moneyLabel.Text = formatMoney(money.Value)

	money:GetPropertyChangedSignal("Value"):Connect(function()
		moneyLabel.Text = formatMoney(money.Value)
	end)
end

updateMoney()]]></ProtectedString>
