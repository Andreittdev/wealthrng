-- DESCHIDERE / ÎNCHIDERE
--------------------------------------------------

local function openShop()
print("=== openshop()CALLED ===")
	overlay.Visible = true

	mainFrame.Size = isMobile
		and UDim2.fromScale(0.84, 0.76)
		or UDim2.fromOffset(800, 500)

	local targetSize = isMobile
		and UDim2.fromScale(0.94, 0.88)
		or UDim2.fromOffset(900, 560)

	TweenService:Create(
		mainFrame,
		TweenInfo.new(
			0.2,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Size = targetSize
		}
	):Play()
end

local function closeShop()
	infoPopup.Visible = false
	overlay.Visible = false
end
eggHatchResultEvent.OnClientEvent:Connect(function(data)
	if not data or not data.Success then
		warn(data and data.Message or "Hatch failed")
		return
	end

	local results = data.Results
	if not results or #results == 0 then
		return
	end

	local firstResult = results[1]

	if firstResult.IsDuplicate then
		resultPetName.Text = firstResult.DisplayName .. " (Duplicate)"
		resultPetRarity.Text = "+$" .. tostring(firstResult.AutoSellCash) .. " cash"
	else
		resultPetName.Text = firstResult.DisplayName
		resultPetRarity.Text = firstResult.Rarity
	end

	resultPopup.Visible = true
end)

print("=== EggShopClient FULLY LOADED ===")
openEggShopEvent.OnClientEvent:Connect(openShop)
closeButton.Activated:Connect(closeShop)

popupClose.Activated:Connect(function()
	infoPopup.Visible = false
end)]]></ProtectedString>
