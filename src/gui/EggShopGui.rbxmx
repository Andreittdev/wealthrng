-- Marginile/pozitiile de mai jos sunt exact cele folosite inainte de
-- EggList (topMarginY/sizeYOffset), doar impartite acum intre doua panouri
-- (bara laterala + continut) in loc de un singur ScrollingFrame.
local sideMargin = isMobile and 14 or 22
local topMarginY = isMobile and 82 or 105
local sizeYOffset = isMobile and -96 or -127
local sidebarWidth = isMobile and 86 or 130
local panelGap = isMobile and 8 or 14

local sidebar = Instance.new("Frame")
sidebar.Name = "Sidebar"
sidebar.Parent = mainFrame
sidebar.Position = UDim2.new(0, sideMargin, 0, topMarginY)
sidebar.Size = UDim2.new(0, sidebarWidth, 1, sizeYOffset)
sidebar.BackgroundTransparency = 1

local tabPadding = isMobile and 6 or 10

local sidebarList = Instance.new("UIListLayout")
sidebarList.Parent = sidebar
sidebarList.FillDirection = Enum.FillDirection.Vertical
sidebarList.Padding = UDim.new(0, tabPadding)
sidebarList.SortOrder = Enum.SortOrder.LayoutOrder

-- renderEgg e definit mai jos (are nevoie de showInfo, care nu exista inca
-- aici) -- butoanele de mai jos apeleaza referinta, populata la finalul
-- scriptului.
local renderEgg

-- Tinut minte ca sa putem re-randa acelasi ou selectat dupa o rotire de
-- telefon (vezi handler-ul de ViewportSize, mai jos in fisier) -- setat de
-- renderEgg insusi, la fiecare apel.
local currentEggIndex = 1

local sidebarButtons = {}

-- Pe MOBIL, inaltimea fiecarui tab e in SCALE (1/tabCount din sidebar), nu
-- in pixeli ficsi -- altfel, pe un telefon cu ecran scund (gen landscape),
-- 5 tab-uri de 52px ficsi + padding depaseau inaltimea reala a sidebar-ului
-- (care e procentuala din mainFrame), iar Legendary/Mythic ramaneau taiate/
-- inaccesibile sub marginea panoului. Cu Scale, cele 5 tab-uri UMPLU EXACT
-- 100% din sidebar, garantat, indiferent cat de mic e ecranul. Pe Desktop
-- ramane 100% neschimbat -- inaltimea fixa de 58px, ca inainte.
local tabCount = #EGG_DATA
local perTabPaddingShare = (tabPadding * (tabCount - 1)) / tabCount

for index, egg in ipairs(EGG_DATA) do
	local tabButton = Instance.new("TextButton")
	tabButton.Name = egg.Type .. "Tab"
	tabButton.Parent = sidebar
	tabButton.LayoutOrder = index
	tabButton.Size = isMobile
		and UDim2.new(1, 0, 1 / tabCount, -perTabPaddingShare)
		or UDim2.new(1, 0, 0, 58)
	tabButton.BackgroundColor3 = egg.Color
	tabButton.Text = TIER_LABELS[egg.Type] or egg.Type
	tabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	tabButton.TextStrokeColor3 = Color3.fromRGB(212, 175, 55)
	tabButton.TextStrokeTransparency = 0.55
	tabButton.TextSize = isMobile and 16 or 15
	tabButton.TextWrapped = true
	-- Pe mobil, "LEGENDARY" nu incapea la TextSize fix (16px) intr-un tab
	-- ingust si aparea taiat ("LEGENDAR"). TextScaled micsoreaza automat
	-- fontul cat sa incapa tot cuvantul -- DOAR pe mobil (desktop ramane
	-- neschimbat, la TextSize fix 15px, ca inainte).
	tabButton.TextScaled = isMobile
	tabButton.Font = PREMIUM_FONT
	tabButton.AutoButtonColor = true

	if isMobile then
		-- TextScaled singur umple tot butonul (buton inalt = text urias pe
		-- BASIC/RARE/EPIC/MYTHIC) -- plafonam marimea maxima, dar tot se
		-- micsoreaza automat sub acest plafon cand nu incape ("LEGENDARY").
		local tabTextConstraint = Instance.new("UITextSizeConstraint")
		tabTextConstraint.MaxTextSize = 16
		tabTextConstraint.Parent = tabButton
	end

	addCorner(tabButton, 10)
	local tabStroke = addStroke(tabButton, Color3.fromRGB(212, 175, 55), 3, 1)

	sidebarButtons[index] = {Button = tabButton, Stroke = tabStroke}

	tabButton.Activated:Connect(function()
		if renderEgg then
			renderEgg(index)
		end
	end)
end

