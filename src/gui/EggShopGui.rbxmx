local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local openEggShopEvent = remotes:WaitForChild("OpenEggShop")
local requestEggHatchEvent = remotes:WaitForChild("RequestEggHatch")
print("=== About to wait for EggHatchResult ===")
local eggHatchResultEvent = remotes:WaitForChild("EggHatchResult")
print("=== EggHatchResult found, continuing ===")

-- openShop e definit mai jos (are nevoie de tot UI-ul deja construit), dar
-- ne conectam la remote ACUM, cat mai devreme -- altfel, intre asta si
-- conectarea de la finalul scriptului sta un waitForRealViewport() (poate
-- dura pana la 3s) + toata constructia UI-ului; daca jucatorul apasa pe
-- prompt-ul Egg Shop chiar in acea fereastra, RemoteEvent-ul se pierde
-- definitiv (nu tine coada). Closure-ul de mai jos apeleaza upvalue-ul
-- "openShop" abia cand evenimentul chiar soseste, mult mai tarziu -- pana
-- atunci va fi deja asignat.
local openShop
openEggShopEvent.OnClientEvent:Connect(function()
	openShop()
end)

local PetDatabase = require(ReplicatedStorage.Modules:WaitForChild("PetDatabase"))

-- LuckiestGuy -- deja folosit in alt loc din joc (butonul de Settings), deci
-- stim sigur ca exista pe acest Roblox.
local PREMIUM_FONT = Enum.Font.LuckiestGuy

local screenGui = script.Parent

-- "Mobil" = are touch SAU ecranul e mic/scund (unele device-uri/ferestre
-- raporteaza TouchEnabled=false chiar si pe telefon in Studio), ca sa se
-- activeze layout-ul compact deja construit mai jos (carduri stivuite,
-- fonturi/padding mai mici) -- nu doar marimea panoului principal.
local function computeIsMobile()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	return UserInputService.TouchEnabled or viewport.X < 700 or viewport.Y < 500
end

-- Pe telefon REAL (nu Studio), am vazut Egg Shop-ul aparand uriaș (marimea
-- fixa de Desktop, 900x560px) -- semn ca "isMobile" s-a "copt" gresit ca
-- FALSE chiar la pornire, inainte ca Camera sa fi raportat rezolutia reala
-- a ecranului (ViewportSize poate porni cu o valoare implicita/desktop-like
-- pentru cateva fractiuni de secunda la cold-start pe unele telefoane) --
-- si TOT panoul e construit O SINGURA DATA, cu "isMobile" ingropat peste tot
-- (marimi/fonturi/padding), deci o valoare gresita la acest moment ramane
-- gresita pentru toata sesiunea. Asteptam pana Camera raporteaza un
-- ViewportSize real (nenul) inainte sa decidem, ca sa nu se mai "inghete"
-- gresit pe desktop-size.
local function waitForRealViewport()
	local attempts = 0

	while attempts < 30 do
		local camera = workspace.CurrentCamera

		if camera and camera.ViewportSize.Magnitude > 1 then
			return
		end

		task.wait(0.1)
		attempts += 1
	end
end

waitForRealViewport()

local isMobile = computeIsMobile()

-- Marimea panoului principal. Pe PC ramane neschimbata (900x560, fix).
-- Pe mobil se calculeaza procentual din ecranul real, cu margine vizibila.
--
-- INDIFERENT de ramura aleasa mai jos, rezultatul final e mereu limitat
-- (clamp) la ecranul real curent, minus o marja -- asta garanteaza ca
-- panoul NU poate niciodata depasi/iesi de pe ecran, chiar daca "isMobile"
-- ar fi fost detectat gresit la un moment dat (asa a aparut bug-ul "shop
-- uriaș" pe telefon: ramura Desktop, 900x560px ficsi, fara nicio limitare
-- fata de ecranul real, mult mai mic pe un telefon).
local function getMainFrameSize(scaleFactor)
	scaleFactor = scaleFactor or 1

	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)

	local baseWidth, baseHeight

	if isMobile then
		baseWidth = viewport.X * 0.85
		baseHeight = viewport.Y * 0.7
	else
		baseWidth = 900
		baseHeight = 560
	end

	local width = math.min(baseWidth, viewport.X - 40) * scaleFactor
	local height = math.min(baseHeight, viewport.Y - 40) * scaleFactor

	return UDim2.fromOffset(width, height)
end

