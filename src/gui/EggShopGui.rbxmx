		Price = 500000,
		Color = Color3.fromRGB(255, 205, 65),
		Pets = {
			"King of Kicks — 39.9%",
			"Hype Dragon — 30%",
			"Diamond Emperor — 20%",
			"Billionaire Beast — 10%",
			"SECRET — 0.1%"
		}
	},
	{
		Type = "Mythic",
		DisplayName = "Mythic Egg",
		Price = 2500000,
		Color = Color3.fromRGB(255, 70, 105),
		Pets = {
			"Market Titan — 39.5%",
			"Golden Mogul — 30%",
