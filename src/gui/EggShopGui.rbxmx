local function showInfo(egg)
	popupTitle.Text = egg.DisplayName

	local lines = {
		"Price: " .. formatMoney(egg.Price),
		"",
		"Possible pets:"
	}

	for _, petLine in ipairs(egg.Pets) do
		table.insert(lines, "• " .. petLine)
	end

	popupContent.Text = table.concat(lines, "\n")
	infoPopup.Visible = true
end

--------------------------------------------------
-- CARDURILE OUĂLOR
--------------------------------------------------

for index, egg in ipairs(EGG_DATA) do
	local card = Instance.new("Frame")
	card.Name = egg.Type .. "Card"
	card.Parent = scrollingFrame
	card.LayoutOrder = index
	card.BackgroundColor3 = Color3.fromRGB(38, 39, 50)
	card.BorderSizePixel = 0

	addCorner(card, 14)

	local cardStroke = addStroke(
		card,
		egg.Color,
		2,
		0
	)

	local eggPreview, glow, eggBody =
		createPremiumEggPreview(card, egg)

	local nameY = isMobile and 152 or 195
	local priceY = isMobile and 188 or 235

	local nameLabel = createText(
		card,
		"EggName",
		egg.DisplayName,
		UDim2.new(1, -20, 0, 35),
		UDim2.new(0, 10, 0, nameY),
		isMobile and 20 or 24,
		egg.Color
	)

	local priceLabel = createText(
		card,
		"Price",
		formatMoney(egg.Price),
		UDim2.new(1, -20, 0, 30),
		UDim2.new(0, 10, 0, priceY),
		isMobile and 17 or 20,
		Color3.fromRGB(100, 255, 135)
	)

	local infoButton = Instance.new("TextButton")
	infoButton.Name = "InfoButton"
	infoButton.Parent = card
	infoButton.Size = UDim2.new(0.42, 0, 0, 38)
	infoButton.Position = UDim2.new(0.06, 0, 1, -52)
	infoButton.BackgroundColor3 = Color3.fromRGB(70, 75, 95)
	infoButton.Text = "INFO"
	infoButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	infoButton.TextSize = isMobile and 14 or 16
	infoButton.Font = Enum.Font.FredokaOne
	infoButton.AutoButtonColor = true

	addCorner(infoButton, 10)

	local hatchButton = Instance.new("TextButton")
	hatchButton.Name = "HatchButton"
	hatchButton.Parent = card
	hatchButton.Size = UDim2.new(0.42, 0, 0, 38)
	hatchButton.Position = UDim2.new(0.52, 0, 1, -52)
	hatchButton.BackgroundColor3 = Color3.fromRGB(65, 185, 95)
	hatchButton.Text = "HATCH"
	hatchButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	hatchButton.TextSize = isMobile and 14 or 16
	hatchButton.Font = Enum.Font.FredokaOne
	hatchButton.AutoButtonColor = true

	addCorner(hatchButton, 10)

	infoButton.Activated:Connect(function()
		showInfo(egg)
	end)

	hatchButton.Activated:Connect(function()
		requestEggHatchEvent:FireServer(egg.Type, 1)
	end)

	-- Hover doar pentru PC
	if not isMobile then
		local originalCardColor = card.BackgroundColor3
		local originalPreviewSize = eggPreview.Size

		card.MouseEnter:Connect(function()
			TweenService:Create(
				card,
				TweenInfo.new(
					0.14,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.Out
				),
				{
					BackgroundColor3 =
						originalCardColor:Lerp(
							egg.Color,
							0.08
						)
				}
			):Play()

			TweenService:Create(
				eggPreview,
				TweenInfo.new(
					0.16,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{
					Size = UDim2.fromOffset(
						originalPreviewSize.X.Offset + 8,
						originalPreviewSize.Y.Offset + 10
					)
				}
			):Play()

			TweenService:Create(
				glow,
				TweenInfo.new(0.14),
				{
					BackgroundTransparency = 0.36
				}
			):Play()

			cardStroke.Thickness = 3
		end)

		card.MouseLeave:Connect(function()
			TweenService:Create(
				card,
				TweenInfo.new(
					0.14,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.Out
				),
				{
					BackgroundColor3 = originalCardColor
				}
			):Play()

			TweenService:Create(
				eggPreview,
				TweenInfo.new(
					0.16,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.Out
				),
				{
					Size = originalPreviewSize
				}
			):Play()

			TweenService:Create(
				glow,
				TweenInfo.new(0.14),
				{
					BackgroundTransparency = 0.58
				}
			):Play()

			cardStroke.Thickness = 2
		end)
	end
end

