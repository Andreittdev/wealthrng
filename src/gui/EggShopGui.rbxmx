-- Mesaj scurt (toast), pentru cand serverul refuza actiunea (ex: nu are
-- destui bani) -- dispare singur dupa 2 secunde.
local errorToast = Instance.new("Frame")
errorToast.Name = "ErrorToast"
errorToast.Parent = overlay
errorToast.AnchorPoint = Vector2.new(0.5, 1)
errorToast.Position = UDim2.new(0.5, 0, 1, -30)
errorToast.Size = isMobile and UDim2.fromOffset(280, 50) or UDim2.fromOffset(340, 56)
errorToast.BackgroundColor3 = Color3.fromRGB(60, 20, 24)
errorToast.BorderSizePixel = 0
errorToast.Visible = false
errorToast.ZIndex = 40

addCorner(errorToast, 12)
addStroke(errorToast, Color3.fromRGB(230, 80, 80), 2, 0)

local errorToastLabel = createText(
	errorToast,
	"Message",
	"",
	UDim2.new(1, -16, 1, -12),
	UDim2.new(0, 8, 0, 6),
	isMobile and 14 or 16,
	Color3.fromRGB(255, 210, 210)
)
errorToastLabel.ZIndex = 41

local errorToastToken = 0

local function showErrorToast(message)
	errorToastToken += 1
	local myToken = errorToastToken

	errorToastLabel.Text = message
	errorToast.Visible = true

	task.delay(2, function()
		if myToken == errorToastToken then
			errorToast.Visible = false
		end
	end)
end

local function showInfo(egg)
	popupTitle.Text = egg.DisplayName

	local lines = {
		"Price: " .. formatMoney(egg.Price),
		"",
		"Possible pets:"
	}

	for _, petLine in ipairs(egg.Pets) do
		table.insert(lines, "• " .. petLine)
	end

	popupContent.Text = table.concat(lines, "\n")
	infoPopup.Visible = true
end

--------------------------------------------------
-- PANOUL OULUI SELECTAT (preview + top 3 peturi + butoane)
--------------------------------------------------

local PREMIUM_GOLD = Color3.fromRGB(212, 175, 55)

local cardGap = isMobile and 8 or 14
local cardW, cardH, mobileButtonHeight, mobileButtonGap

-- Extras intr-o functie (nu doar cod direct la nivelul scriptului) ca sa
-- poata fi RE-CHEMATA cand jucatorul roteste telefonul cat timp shop-ul e
-- deschis (vezi handler-ul de ViewportSize, mai jos) -- altfel, cardH ramanea
-- calculat o singura data, la marimea de dinainte de rotire, si peturile/
-- butoanele puteau iesi din panou dupa o rotire spre un ecran mai scund.
local function recomputeMobileCardMetrics()
	cardW = isMobile and 90 or 140
	cardH = isMobile and 150 or 190
	mobileButtonHeight = 40
	mobileButtonGap = 16

	-- MOBIL (DOAR mobil -- desktop ramane 100% neschimbat, valorile "or" de
	-- mai jos raman identice): pe un telefon cu ecran scund (ex: landscape),
	-- cardH=150 + butoanele Hatch/Info (40px) puteau depasi spatiul REAL
	-- disponibil in contentPanel, impingand peturile/butoanele sub marginea
	-- panoului (taiate/inaccesibile). Recalculam din inaltimea reala
	-- disponibila, cu un plafon minim/maxim rezonabil, ca sa incapa GARANTAT.
	if isMobile then
		-- NU folosim contentPanel.AbsoluteSize.Y direct -- fiind Scale (1,
		-- relativ la mainFrame), s-a dovedit nesigur/intarziat. mainFrame.Size
		-- e insa 100% Offset (fara Scale, vezi getMainFrameSize), deci
		-- AbsoluteSize-ul lui e mereu instant/corect, indiferent de parinte
		-- -- calculam manual acelasi rezultat (contentPanel foloseste exact
		-- aceeasi formula, 1, sizeYOffset, pentru inaltime).
		local availableHeight = mainFrame.AbsoluteSize.Y + sizeYOffset

		mobileButtonHeight = 26
		mobileButtonGap = 6

		if availableHeight > 0 then
			local headerHeight = 66 -- EggName + Price + TopLabel (compactate) + topRowY
			local reserved = headerHeight + mobileButtonGap + mobileButtonHeight + 6
			local remaining = availableHeight - reserved

			-- Plafon de jos ridicat la 65 -- sub asta, peturile deveneau
			-- practic invizibile (imaginea + text ilizibile). Daca spatiul
			-- chiar nu ajunge (caz extrem), preferam sa lasam peturile
			-- vizibile chiar daca butoanele ajung usor mai jos, decat sa
			-- avem un shop inutil (nu se vede ce poti castiga).
			cardH = math.clamp(remaining, 65, 150)
		else
			-- N-am putut masura inaltimea reala (caz extrem) -- preferam o
			-- valoare mica/sigura in loc de cea originala (150), care e
			-- exact cea care cauza depasirea ecranului.
			cardH = 90
		end

		-- cardW ramane NESCHIMBAT -- pe telefon (mai ales landscape),
		-- latimea e abundenta, doar inaltimea e limitata. Micsorarea
		-- proportionala a latimii facea numele peturilor ilizibile
		-- ("Sneaker Bunny" taiat la "SNEA") fara niciun beneficiu real.
	end
end

recomputeMobileCardMetrics()

renderEgg = function(index)
	currentEggIndex = index
	local egg = EGG_DATA[index]

	for i, entry in ipairs(sidebarButtons) do
		local isSelected = (i == index)
		entry.Button.BackgroundColor3 = isSelected
			and EGG_DATA[i].Color
			or EGG_DATA[i].Color:Lerp(Color3.fromRGB(20, 20, 25), 0.55)
		entry.Stroke.Transparency = isSelected and 0 or 1
	end

	for _, child in ipairs(contentPanel:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	-- Fara desenul oului -- vrem peturile mari, in centrul atentiei, nu oul.
	local eggNameLabel = createText(
		contentPanel,
		"EggName",
		egg.DisplayName,
		UDim2.new(1, -20, 0, isMobile and 22 or 40),
		UDim2.new(0, 10, 0, isMobile and 6 or 18),
		isMobile and 20 or 32,
		egg.Color,
		Enum.TextXAlignment.Center
	)
	eggNameLabel.TextStrokeColor3 = Color3.fromRGB(212, 175, 55)
	eggNameLabel.TextStrokeTransparency = 0.6

	createText(
		contentPanel,
		"Price",
		formatMoney(egg.Price),
		UDim2.new(1, -20, 0, isMobile and 18 or 28),
		UDim2.new(0, 10, 0, isMobile and 30 or 60),
		isMobile and 14 or 20,
		Color3.fromRGB(100, 255, 135),
		Enum.TextXAlignment.Center
	)

	createText(
		contentPanel,
		"TopLabel",
		"⭐ TOP PETS",
		UDim2.new(1, -20, 0, isMobile and 14 or 24),
		UDim2.new(0, 10, 0, isMobile and 50 or 96),
		isMobile and 12 or 17,
		PREMIUM_GOLD,
		Enum.TextXAlignment.Center
	)

	local topRowY = isMobile and 66 or 126

	local topRow = Instance.new("Frame")
	topRow.Name = "TopPetsRow"
	topRow.Parent = contentPanel
	topRow.BackgroundTransparency = 1
	topRow.Position = UDim2.new(0, 0, 0, topRowY)
	topRow.Size = UDim2.new(1, 0, 0, cardH)

	local rowList = Instance.new("UIListLayout")
	rowList.Parent = topRow
	rowList.FillDirection = Enum.FillDirection.Horizontal
	rowList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	rowList.VerticalAlignment = Enum.VerticalAlignment.Center
	rowList.Padding = UDim.new(0, cardGap)
	rowList.SortOrder = Enum.SortOrder.LayoutOrder

	local topPets = getTopPets(egg, 3)

	for i, pet in ipairs(topPets) do
		local color = PET_RARITY_COLORS[pet.Rarity] or Color3.fromRGB(150, 150, 150)

		-- Fara card (fara fundal/contur) -- doar poza mare, nume si sansa.
		local mini = Instance.new("Frame")
		mini.Name = "TopPet" .. i
		mini.Parent = topRow
		mini.LayoutOrder = i
		mini.Size = UDim2.fromOffset(cardW, cardH)
		mini.BackgroundTransparency = 1

		if pet.IsSecret then
			createText(
				mini,
				"Mystery",
				"❔",
				UDim2.new(0.7, 0, 0.6, 0),
				UDim2.new(0.15, 0, 0, 0),
				isMobile and 40 or 56,
				Color3.fromRGB(255, 255, 255)
			)
		else
			local img = Instance.new("ImageLabel")
			img.Name = "PetImage"
			img.Parent = mini
			img.BackgroundTransparency = 1
			img.AnchorPoint = Vector2.new(0.5, 0)
			img.Position = UDim2.new(0.5, 0, 0, 0)
			-- Pe mobil, imaginea + numele + sansa sunt in SCALE (procent din
			-- cardH), nu pixeli ficsi -- altfel, cand cardH se micsoreaza pe
			-- un ecran scund, inaltimile ficse ale numelui/sansei (18+16px)
			-- nu mai incapeau in restul de spatiu si se suprapuneau peste
			-- imagine. Pe Desktop ramane 100% neschimbat (0.78 fix, ca inainte).
			img.Size = UDim2.new(1, 0, isMobile and 0.68 or 0.78, 0)
			img.Image = pet.Image or ""
			img.ScaleType = Enum.ScaleType.Fit
		end

		local petName = createText(
			mini,
			"PetName",
			pet.DisplayName,
			isMobile and UDim2.new(1, 0, 0.16, 0) or UDim2.new(1, 0, 0, 22),
			isMobile and UDim2.new(0, 0, 0.68, 0) or UDim2.new(0, 0, 0.8, 0),
			isMobile and 13 or 16,
			color
		)
		petName.TextWrapped = true
		if isMobile then
			petName.TextScaled = true
		end

		local petChance = createText(
			mini,
			"PetChance",
			pet.Chance,
			isMobile and UDim2.new(1, 0, 0.16, 0) or UDim2.new(1, 0, 0, 20),
			isMobile and UDim2.new(0, 0, 0.84, 0) or UDim2.new(0, 0, 0.91, 0),
			isMobile and 11 or 14,
			Color3.fromRGB(200, 200, 210)
		)
		if isMobile then
			petChance.TextScaled = true
		end
	end

	local buttonsY = topRowY + cardH + (isMobile and mobileButtonGap or 22)

	local buttonsRow = Instance.new("Frame")
	buttonsRow.Name = "ButtonsRow"
	buttonsRow.Parent = contentPanel
	buttonsRow.BackgroundTransparency = 1
	buttonsRow.Position = UDim2.new(0, 0, 0, buttonsY)
	buttonsRow.Size = UDim2.new(1, 0, 0, isMobile and mobileButtonHeight or 44)

	local buttonsList = Instance.new("UIListLayout")
	buttonsList.Parent = buttonsRow
	buttonsList.FillDirection = Enum.FillDirection.Horizontal
	buttonsList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	buttonsList.VerticalAlignment = Enum.VerticalAlignment.Center
	buttonsList.Padding = UDim.new(0, isMobile and 10 or 16)
	buttonsList.SortOrder = Enum.SortOrder.LayoutOrder

	local infoButton = Instance.new("TextButton")
	infoButton.Name = "InfoButton"
	infoButton.Parent = buttonsRow
	infoButton.LayoutOrder = 1
	infoButton.Size = UDim2.new(0, isMobile and 82 or 130, 0, isMobile and mobileButtonHeight or 40)
	infoButton.BackgroundColor3 = Color3.fromRGB(70, 75, 95)
	infoButton.Text = "INFO"
	infoButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	infoButton.TextSize = isMobile and 12 or 16
	infoButton.Font = PREMIUM_FONT
	infoButton.AutoButtonColor = true
	addCorner(infoButton, 10)

	infoButton.Activated:Connect(function()
		showInfo(egg)
	end)

	local hatchButton = Instance.new("TextButton")
	hatchButton.Name = "HatchButton"
	hatchButton.Parent = buttonsRow
	hatchButton.LayoutOrder = 2
	hatchButton.Size = UDim2.new(0, isMobile and 110 or 190, 0, isMobile and mobileButtonHeight or 40)
	hatchButton.BackgroundColor3 = PREMIUM_GOLD
	hatchButton.Text = "HATCH"
	hatchButton.TextColor3 = Color3.fromRGB(30, 24, 8)
	hatchButton.TextSize = isMobile and 12 or 16
	hatchButton.Font = PREMIUM_FONT
	hatchButton.AutoButtonColor = true
	addCorner(hatchButton, 10)

	hatchButton.Activated:Connect(function()
		requestEggHatchEvent:FireServer(egg.Type, 1)
	end)
end

renderEgg(1)

--------------------------------------------------
-- DESCHIDERE / ÎNCHIDERE
--------------------------------------------------

openShop = function()
print("=== openshop()CALLED ===")
	overlay.Visible = true
	player:SetAttribute("ShopModalOpen", true)

	mainFrame.Size = getMainFrameSize(0.88)

	local targetSize = getMainFrameSize()

	TweenService:Create(
		mainFrame,
		TweenInfo.new(
			0.2,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Size = targetSize
		}
	):Play()
end

local function closeShop()
	infoPopup.Visible = false
	overlay.Visible = false
	player:SetAttribute("ShopModalOpen", false)
end

-- Daca jucatorul roteste telefonul cat timp shop-ul e deschis, recalculam
-- marimea SI metricile mobile (cardH/cardW/butoane), apoi re-randam oul
-- selectat -- altfel ramaneau "inghetate" la marimea de dinainte de rotire
-- (bug gasit la audit: rotind spre un ecran mai scund, peturile/butoanele
-- puteau iesi din nou din panou).
do
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if overlay.Visible then
				mainFrame.Size = getMainFrameSize()

				if isMobile then
					recomputeMobileCardMetrics()
					renderEgg(currentEggIndex)
				end
			end
		end)
	end
end

local ERROR_MESSAGES = {
	NotEnoughMoney = "❌ Not enough money!"
}

eggHatchResultEvent.OnClientEvent:Connect(function(data)
	if not data or not data.Success then
		local errorCode = data and data.Message
		showErrorToast(ERROR_MESSAGES[errorCode] or "❌ Couldn't open the egg")
		return
	end

	local results = data.Results
	if not results or #results == 0 then
		return
	end

	local firstResult = results[1]
	local petData = firstResult.PetId and PetDatabase.Pets[firstResult.PetId]
	resultPetImage.Image = petData and petData.Image or ""

	if firstResult.IsDuplicate then
		resultPetName.Text = firstResult.DisplayName .. " (Duplicate)"
		resultPetRarity.Text = "+$" .. tostring(firstResult.AutoSellCash) .. " cash"
	else
		resultPetName.Text = firstResult.DisplayName
		resultPetRarity.Text = firstResult.Rarity
	end

	resultPopup.Visible = true
end)

print("=== EggShopClient FULLY LOADED ===")
closeButton.Activated:Connect(closeShop)

popupClose.Activated:Connect(function()
	infoPopup.Visible = false
end)]]></ProtectedString>
