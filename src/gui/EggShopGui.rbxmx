-- Concept nou de shop: in loc sa afisam toate cele 5 oua deodata intr-o
-- lista, jucatorul alege raritatea dintr-o bara laterala (stanga), iar
-- panoul principal arata DOAR oul selectat + cele mai bune 3 peturi din el
-- (cele cu sansa cea mai mica -- ultimele 3 din lista, care e deja sortata
-- descrescator dupa sansa).
local PET_RARITY_COLORS = {
	Common = Color3.fromRGB(150, 150, 150),
	Rare = Color3.fromRGB(60, 150, 255),
	Epic = Color3.fromRGB(170, 90, 255),
	Legendary = Color3.fromRGB(255, 205, 65),
	Mythic = Color3.fromRGB(255, 70, 180),
	Secret = Color3.fromRGB(230, 230, 235)
}

local TIER_LABELS = {
	Basic = "BASIC",
	Rare = "RARE",
	Epic = "EPIC",
	Legendary = "LEGENDARY",
	Mythic = "MYTHIC"
}

-- Cautare dupa DisplayName (nu case-sensitive) -- textul din EGG_DATA.Pets
-- ("Name — X%") trebuie sa gaseasca acelasi pet in PetDatabase, ca sa-i
-- luam imaginea si raritatea reale.
local petByLowerName = {}
for _, data in pairs(PetDatabase.Pets) do
	petByLowerName[data.DisplayName:lower()] = data
end

local function parsePetLineName(line)
	return (line:match("^(.-)%s*—") or line):gsub("%s+$", "")
end

local function parsePetLineChance(line)
	return line:match("—%s*(.+)$") or ""
end

-- Ultimele 3 din lista = cele cu sansa cea mai mica (lista e deja sortata
-- descrescator) -- adica exact cele mai "bune" (rare) 3 peturi din ou.
-- "SECRET" ramane ascuns (afisat ca "???", fara nume/imagine reala), la fel
-- ca in popup-ul de info -- nu stricam surpriza.
local function getTopPets(egg, count)
	count = count or 3
	local list = egg.Pets
	local startIndex = math.max(1, #list - count + 1)
	local results = {}

	for i = startIndex, #list do
		local name = parsePetLineName(list[i])
		local chance = parsePetLineChance(list[i])

		if name == "SECRET" then
			table.insert(results, {IsSecret = true, DisplayName = "???", Rarity = "Secret", Image = "", Chance = chance})
		else
			local data = petByLowerName[name:lower()]
			table.insert(results, {
				IsSecret = false,
				DisplayName = data and data.DisplayName or name,
				Rarity = data and data.Rarity or "Common",
				Image = data and data.Image or "",
				Chance = chance
			})
		end
	end

	return results
end

local function formatMoney(amount)
	local formatted = tostring(amount)

	while true do
		local newValue, count =
			formatted:gsub("^(-?%d+)(%d%d%d)", "%1,%2")

		formatted = newValue

		if count == 0 then
			break
		end
	end

	return "$" .. formatted
end

local function addCorner(instance, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = instance
	return corner
end

local function addStroke(instance, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.Transparency = transparency or 0
	stroke.Parent = instance
	return stroke
end

local function createText(
	parent,
	name,
	text,
	size,
	position,
	textSize,
	color,
	alignment
)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Parent = parent
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextSize = textSize
	label.TextColor3 = color
	label.Font = PREMIUM_FONT
	label.TextXAlignment = alignment or Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextWrapped = true

	return label
end

local function createDecorationFrame(
	parent,
	name,
	position,
	size,
	color,
	rotation,
	zIndex,
	transparency
)
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Parent = parent
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = position
	frame.Size = size
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.BorderSizePixel = 0
	frame.Rotation = rotation or 0
	frame.ZIndex = zIndex or 6

	addCorner(frame, 999)

	return frame
end

local function createDiamond(
	parent,
	name,
	position,
	size,
	color,
	rotation,
	zIndex
)
	local diamond = Instance.new("Frame")
	diamond.Name = name
	diamond.Parent = parent
	diamond.AnchorPoint = Vector2.new(0.5, 0.5)
	diamond.Position = position
	diamond.Size = size
	diamond.BackgroundColor3 = color
	diamond.BorderSizePixel = 0
	diamond.Rotation = rotation or 45
	diamond.ZIndex = zIndex or 7

	addCorner(diamond, 3)
	addStroke(
		diamond,
		Color3.fromRGB(255, 255, 255),
		1,
		0.35
	)

	return diamond
end

local function createPremiumEggPreview(parent, egg)
	local container = Instance.new("Frame")
	container.Name = "PremiumEggPreview"
	container.Parent = parent
	container.AnchorPoint = Vector2.new(0.5, 0)
	container.Position = UDim2.new(0.5, 0, 0, isMobile and 10 or 16)
	container.Size = UDim2.fromOffset(
		isMobile and 112 or 150,
		isMobile and 132 or 178
	)
	container.BackgroundTransparency = 1
	container.ZIndex = 2

	local startPosition = container.Position

	-- Aură exterioară
	local glow = Instance.new("Frame")
	glow.Name = "Glow"
	glow.Parent = container
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromScale(0.5, 0.53)
	glow.Size = UDim2.fromScale(0.88, 0.82)
	glow.BackgroundColor3 = egg.Color
	glow.BackgroundTransparency = 0.58
	glow.BorderSizePixel = 0
	glow.ZIndex = 1

	addCorner(glow, 999)

	local glowStroke = addStroke(
		glow,
		egg.Color,
		egg.Type == "Mythic" and 7
			or egg.Type == "Legendary" and 6
			or 4,
		0.42
	)

	-- Forma oului
	local eggBody = Instance.new("Frame")
	eggBody.Name = "EggBody"
	eggBody.Parent = container
	eggBody.AnchorPoint = Vector2.new(0.5, 0.5)
	eggBody.Position = UDim2.fromScale(0.5, 0.52)
	eggBody.Size = UDim2.fromScale(0.72, 0.86)
	eggBody.BackgroundColor3 = egg.Color
	eggBody.BorderSizePixel = 0
	eggBody.ZIndex = 3

	local eggCorner = Instance.new("UICorner")
	eggCorner.CornerRadius = UDim.new(0.46, 0)
	eggCorner.Parent = eggBody

	local eggStroke = addStroke(
		eggBody,
		Color3.fromRGB(245, 245, 250),
		2,
		0.25
	)

	local darkColor =
		egg.Color:Lerp(Color3.fromRGB(8, 9, 15), 0.6)

	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 35
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(
			0,
			Color3.fromRGB(255, 255, 255)
		),
		ColorSequenceKeypoint.new(0.24, egg.Color),
		ColorSequenceKeypoint.new(1, darkColor)
	})
	gradient.Parent = eggBody

	-- Reflexie
	local shine = Instance.new("Frame")
	shine.Name = "Shine"
	shine.Parent = eggBody
	shine.Position = UDim2.fromScale(0.16, 0.09)
	shine.Size = UDim2.fromScale(0.17, 0.4)
	shine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	shine.BackgroundTransparency = 0.4
	shine.BorderSizePixel = 0
	shine.Rotation = 16
	shine.ZIndex = 8

	addCorner(shine, 999)

	-- Umbra/baza
	local baseGlow = Instance.new("Frame")
	baseGlow.Name = "BaseGlow"
	baseGlow.Parent = container
	baseGlow.AnchorPoint = Vector2.new(0.5, 0.5)
	baseGlow.Position = UDim2.fromScale(0.5, 0.94)
	baseGlow.Size = UDim2.fromScale(0.86, 0.1)
	baseGlow.BackgroundColor3 = egg.Color
	baseGlow.BackgroundTransparency = 0.08
	baseGlow.BorderSizePixel = 0
	baseGlow.ZIndex = 2

	addCorner(baseGlow, 999)

	--------------------------------------------------
	-- BASIC
	--------------------------------------------------

	if egg.Type == "Basic" then
		eggBody.BackgroundColor3 =
			Color3.fromRGB(205, 166, 108)

		-- Bandă albă centrală
		local whiteStripe = createDecorationFrame(
			eggBody,
			"WhiteStripe",
			UDim2.fromScale(0.5, 0.58),
			UDim2.fromScale(0.88, 0.09),
			Color3.fromRGB(242, 238, 225),
			-7,
			5,
			0.08
		)

		-- Bandă neagră mică
		createDecorationFrame(
			eggBody,
			"BlackStripe",
			UDim2.fromScale(0.52, 0.69),
			UDim2.fromScale(0.58, 0.045),
			Color3.fromRGB(28, 29, 34),
			6,
			6,
			0.05
		)

		-- Simbol simplu asemănător unei tălpi
		local sole = createDecorationFrame(
			eggBody,
			"SoleSymbol",
			UDim2.fromScale(0.5, 0.46),
			UDim2.fromScale(0.46, 0.14),
			Color3.fromRGB(245, 245, 245),
			-10,
			7,
			0.05
		)

		sole.AnchorPoint = Vector2.new(0.5, 0.5)

		for index = 1, 3 do
			createDecorationFrame(
				eggBody,
				"BlackSpot" .. index,
				UDim2.fromScale(
					0.28 + index * 0.14,
					0.31 + (index % 2) * 0.09
				),
				UDim2.fromScale(0.07, 0.055),
				Color3.fromRGB(35, 35, 40),
				index * 17,
				7,
				0.08
			)
		end

		--------------------------------------------------
		-- RARE
		--------------------------------------------------

	elseif egg.Type == "Rare" then
		eggBody.BackgroundColor3 =
			Color3.fromRGB(45, 135, 245)

		for _, y in ipairs({0.31, 0.68}) do
			createDecorationFrame(
				eggBody,
				"RareBand",
				UDim2.fromScale(0.5, y),
				UDim2.fromScale(0.9, 0.065),
				Color3.fromRGB(228, 242, 255),
				0,
				5,
				0.12
			)
		end

		-- Cadran geometric
		local watchFace = Instance.new("Frame")
		watchFace.Name = "WatchFace"
		watchFace.Parent = eggBody
		watchFace.AnchorPoint = Vector2.new(0.5, 0.5)
		watchFace.Position = UDim2.fromScale(0.5, 0.5)
		watchFace.Size = UDim2.fromScale(0.33, 0.24)
		watchFace.BackgroundColor3 =
			Color3.fromRGB(22, 30, 46)
		watchFace.BorderSizePixel = 0
		watchFace.ZIndex = 7

		addCorner(watchFace, 999)
		addStroke(
			watchFace,
			Color3.fromRGB(235, 245, 255),
			2,
			0.15
		)

		createDecorationFrame(
			watchFace,
			"WatchHandOne",
			UDim2.fromScale(0.5, 0.5),
			UDim2.fromScale(0.05, 0.32),
			Color3.fromRGB(255, 255, 255),
			25,
			8,
			0
		)

		createDecorationFrame(
			watchFace,
			"WatchHandTwo",
			UDim2.fromScale(0.5, 0.5),
			UDim2.fromScale(0.34, 0.05),
			Color3.fromRGB(255, 255, 255),
			-15,
			8,
			0
		)

		-- LED-uri
		local ledPositions = {
			UDim2.fromScale(0.25, 0.42),
			UDim2.fromScale(0.75, 0.42),
			UDim2.fromScale(0.3, 0.58),
			UDim2.fromScale(0.7, 0.58)
		}

		for index, position in ipairs(ledPositions) do
			createDecorationFrame(
				eggBody,
				"RareLed" .. index,
				position,
				UDim2.fromScale(0.055, 0.045),
				Color3.fromRGB(220, 250, 255),
				0,
				8,
				0
			)
		end

		--------------------------------------------------
		-- EPIC
		--------------------------------------------------

	elseif egg.Type == "Epic" then
		eggBody.BackgroundColor3 =
			Color3.fromRGB(145, 65, 235)

		-- Cristal central
		createDiamond(
			eggBody,
			"MainCrystal",
			UDim2.fromScale(0.5, 0.5),
			UDim2.fromScale(0.28, 0.22),
			Color3.fromRGB(225, 185, 255),
			45,
			8
		)

		-- Cristale laterale
		createDiamond(
			eggBody,
			"LeftCrystal",
			UDim2.fromScale(0.27, 0.58),
			UDim2.fromScale(0.14, 0.12),
			Color3.fromRGB(245, 220, 255),
			35,
			7
		)

		createDiamond(
			eggBody,
			"RightCrystal",
			UDim2.fromScale(0.73, 0.58),
			UDim2.fromScale(0.14, 0.12),
			Color3.fromRGB(245, 220, 255),
			55,
			7
		)

		-- Rune discrete
		for index = 1, 3 do
			local rune = createDecorationFrame(
				eggBody,
				"EpicRune" .. index,
				UDim2.fromScale(
					0.25 + (index - 1) * 0.25,
					0.73
				),
				UDim2.fromScale(0.08, 0.028),
				Color3.fromRGB(238, 210, 255),
				index % 2 == 0 and 45 or -45,
				7,
				0.05
			)

			rune.Size = UDim2.fromScale(0.08, 0.028)
		end

		--------------------------------------------------
		-- LEGENDARY
		--------------------------------------------------

	elseif egg.Type == "Legendary" then
		eggBody.BackgroundColor3 =
			Color3.fromRGB(235, 170, 24)

		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(
				0,
				Color3.fromRGB(255, 250, 185)
			),
			ColorSequenceKeypoint.new(
				0.35,
				Color3.fromRGB(255, 198, 55)
			),
			ColorSequenceKeypoint.new(
				1,
				Color3.fromRGB(110, 58, 5)
			)
		})

		-- Coroană construită din forme
		local crownBase = createDecorationFrame(
			container,
			"CrownBase",
			UDim2.fromScale(0.5, 0.11),
			UDim2.fromScale(0.48, 0.09),
			Color3.fromRGB(255, 220, 70),
			0,
			10,
			0
		)

		crownBase.ZIndex = 10

		for index = 1, 3 do
			local spike = createDiamond(
				container,
				"CrownSpike" .. index,
				UDim2.fromScale(
					0.36 + (index - 1) * 0.14,
					index == 2 and 0.035 or 0.065
				),
				UDim2.fromScale(
					index == 2 and 0.12 or 0.1,
					index == 2 and 0.13 or 0.1
				),
				Color3.fromRGB(255, 224, 75),
				45,
				10
			)

			spike.ZIndex = 10
		end

		-- Diamant central
		createDiamond(
			eggBody,
			"LegendaryDiamond",
			UDim2.fromScale(0.5, 0.48),
			UDim2.fromScale(0.24, 0.18),
			Color3.fromRGB(250, 250, 230),
			45,
			8
		)

		-- Diamante laterale
		createDiamond(
			eggBody,
			"LegendaryLeftGem",
			UDim2.fromScale(0.28, 0.56),
			UDim2.fromScale(0.11, 0.09),
			Color3.fromRGB(255, 245, 175),
			45,
			7
		)

		createDiamond(
			eggBody,
			"LegendaryRightGem",
			UDim2.fromScale(0.72, 0.56),
			UDim2.fromScale(0.11, 0.09),
			Color3.fromRGB(255, 245, 175),
			45,
			7
		)

		-- Rune aurii
		for index = 1, 3 do
			local runeOuter = createDiamond(
				eggBody,
				"LegendaryRune" .. index,
				UDim2.fromScale(
					0.26 + (index - 1) * 0.24,
					0.74
				),
				UDim2.fromScale(0.075, 0.06),
				Color3.fromRGB(255, 240, 135),
				45,
				7
			)

			runeOuter.BackgroundTransparency = 0.08
		end

		--------------------------------------------------
		-- MYTHIC
		--------------------------------------------------

	elseif egg.Type == "Mythic" then
		eggBody.BackgroundColor3 =
			Color3.fromRGB(28, 9, 18)

		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(
				0,
				Color3.fromRGB(130, 22, 55)
			),
			ColorSequenceKeypoint.new(
				0.35,
				Color3.fromRGB(38, 9, 23)
			),
			ColorSequenceKeypoint.new(
				1,
				Color3.fromRGB(3, 3, 8)
			)
		})

		eggStroke.Color = Color3.fromRGB(255, 68, 105)
		eggStroke.Transparency = 0.05
		glowStroke.Transparency = 0.18

		-- Crăpături controlate
		local crackData = {
			{
				Position = UDim2.fromScale(0.34, 0.34),
				Rotation = -30,
				Size = UDim2.fromScale(0.025, 0.28)
			},
			{
				Position = UDim2.fromScale(0.45, 0.47),
				Rotation = 28,
				Size = UDim2.fromScale(0.025, 0.25)
			},
			{
				Position = UDim2.fromScale(0.62, 0.34),
				Rotation = 34,
				Size = UDim2.fromScale(0.025, 0.3)
			},
			{
				Position = UDim2.fromScale(0.58, 0.65),
				Rotation = -24,
				Size = UDim2.fromScale(0.025, 0.25)
			}
		}

		for index, crackInfo in ipairs(crackData) do
			local crack = createDecorationFrame(
				eggBody,
				"MythicCrack" .. index,
				crackInfo.Position,
				crackInfo.Size,
				Color3.fromRGB(255, 38, 80),
				crackInfo.Rotation,
				7,
				0
			)

		end

		-- Ochi
		local leftEye = createDecorationFrame(
			eggBody,
			"LeftEye",
			UDim2.fromScale(0.36, 0.46),
			UDim2.fromScale(0.19, 0.055),
			Color3.fromRGB(255, 36, 72),
			12,
			9,
			0
		)

		local rightEye = createDecorationFrame(
			eggBody,
			"RightEye",
			UDim2.fromScale(0.64, 0.46),
			UDim2.fromScale(0.19, 0.055),
			Color3.fromRGB(255, 36, 72),
			-12,
			9,
			0
		)

		addStroke(
			leftEye,
			Color3.fromRGB(255, 145, 165),
			1,
			0.2
		)

		addStroke(
			rightEye,
			Color3.fromRGB(255, 145, 165),
			1,
			0.2
		)

		-- Simbol central
		local centerRing = Instance.new("Frame")
		centerRing.Name = "CenterRing"
		centerRing.Parent = eggBody
		centerRing.AnchorPoint = Vector2.new(0.5, 0.5)
		centerRing.Position = UDim2.fromScale(0.5, 0.68)
		centerRing.Size = UDim2.fromScale(0.24, 0.17)
		centerRing.BackgroundTransparency = 1
		centerRing.ZIndex = 8

		addCorner(centerRing, 999)
		addStroke(
			centerRing,
			Color3.fromRGB(255, 45, 85),
			3,
			0
		)

		createDiamond(
			centerRing,
			"CenterSymbol",
			UDim2.fromScale(0.5, 0.5),
			UDim2.fromScale(0.35, 0.35),
			Color3.fromRGB(255, 70, 110),
			45,
			9
		)
	end

	-- Plutire permanentă
	TweenService:Create(
		container,
		TweenInfo.new(
			1.65,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{
			Position = startPosition - UDim2.fromOffset(0, 6)
		}
	):Play()

	-- Pulsul aurei
	TweenService:Create(
		glow,
		TweenInfo.new(
			1.2,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{
			BackgroundTransparency =
				egg.Type == "Mythic" and 0.34
				or egg.Type == "Legendary" and 0.48
				or 0.72
		}
	):Play()

	TweenService:Create(
		baseGlow,
		TweenInfo.new(
			1.25,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{
			Size = UDim2.fromScale(0.7, 0.065),
			BackgroundTransparency = 0.35
		}
	):Play()

	return container, glow, eggBody
end

